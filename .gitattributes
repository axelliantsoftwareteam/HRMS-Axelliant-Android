# Normalise line endings. Shell scripts, hooks and workflows MUST be LF on every
# platform: a CRLF hook fails with "bad interpreter" on Linux and in CI, which
# reads as a broken guard rather than a broken checkout.
* text=auto eol=lf

*.sh          text eol=lf
*.bash        text eol=lf
.githooks/*   text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile*   text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binaries — never diffed, never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz  binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary

# Generated files: collapse in review, but they are still reviewed.
package-lock.json  linguist-generated=true -diff
yarn.lock          linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
Gemfile.lock       linguist-generated=true -diff
*.expected.sql     linguist-generated=true

# Large media in Git LFS (kept from this repository).
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
