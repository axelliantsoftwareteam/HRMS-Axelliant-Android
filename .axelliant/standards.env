# Axelliant standards configuration for THIS repository.
# Read by every gate in scripts/ and by the CI workflows. Seeded once by sync-standards.sh; owned here.
# Reference: https://github.com/axelliantsoftwareteam/eng-wiki-standards/blob/main/standards/11-ci-cd/gates.md

# ---- branches ----
INTEGRATION_BRANCH=uat
RELEASE_BRANCH=main

# ---- ticket tracker: none | jira | linear | github | azure-boards | other ----
# Anything but "none" makes every commit and PR name a ticket (or say "none" explicitly).
TICKET_TRACKER=none
TICKET_PREFIX=
TICKET_URL=

# ---- the project's folder in the engineering wiki (projects/<name>/) ----
ENG_WIKI_PROJECT=

# ---- code shape ----
# Space-separated "<tree>:<baseline-name>" pairs. Empty = whole repository as one tree.
METHOD_LENGTH_TREES=
METHOD_LENGTH_LIMIT=150

# ---- request path (exception leaks, console logging) ----
# Space-separated directories that serve requests, e.g. "src/Acme.Api src/Acme.Application".
REQUEST_PATH_TREES=
# Extended regex of the reporting helper / documented domain exception.
EXCEPTION_REPORTING_ALLOW="ServiceFailure\.|throw new ServiceException\(|raise ServiceError\(|reportFailure\(|report_failure\("
# Paths allowed to write to the console (startup, CLIs, scripts).
CONSOLE_LOGGING_ALLOW="(^|/)(Program\.cs|main\.py|__main__\.py|manage\.py|cli/|scripts/|tools/)"

# ---- code documentation gate: paths to skip (generated clients, entity folders) ----
CODE_DOCS_EXCLUDE=

# ---- database ----
# postgres | mysql | sqlserver | sqlite
DB_ENGINE=postgres
# snake (all new databases) | pascal (existing SQL Server / EF estates only)
DB_NAMING=snake
DB_APPLIED_GLOBS="database/schema.sql database/migrations/*.sql"
DB_SCHEMA_CONTRACT=database/schema.expected.sql
# DB_SCHEMA_CONTRACT=none (with DB_SCHEMA_CONTRACT_REASON) when migrations are code and the framework checks the model.
DB_SCHEMA_CONTRACT_REASON=
# PostgreSQL extensions the managed server allows (empty = read from Terraform).
DB_ALLOWED_EXTENSIONS=

# ---- Docker: service | compose-only | exempt ----
# service: compose.yaml must BUILD AND RUN the application — every developer runs it in Docker locally.
DOCKER_MODE=service
DOCKER_DEPLOYABLES=
DOCKER_EXEMPT_REASON=

# ---- infrastructure as code: local (infra/ here) | external (INFRA_REPO) | exempt (reason) ----
# Every repository's infrastructure is code: Terraform, Bicep or idempotent Azure CLI scripts.
INFRA_MODE=local
INFRA_DIR=infra
INFRA_REPO=
INFRA_EXEMPT_REASON=

# ---- documentation ----
DOCS_ROUTE_PREFIX=/api/

# ---- files this repository deliberately keeps its own version of (space-separated paths) ----
# Give the reason in a comment. A managed file listed here is neither overwritten by
# sync-standards.sh nor checked; a seed file listed here is never copied in (the repository covers
# it another way, e.g. its own SAST workflow).
STANDARDS_KEEP_LOCAL=

# ---- large files allowed in git (extended regex); give the reason in the PR that adds them ----
LARGE_FILE_ALLOWLIST=
