<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles for the iOS-parity redesign. Sizes use SDP/SSP only. -->
<resources>

    <!-- Text -->
    <style name="Ws.Text" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/ws_text_primary</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Ws.Text.Medium">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>
    <style name="Ws.Text.SemiBold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>
    <!-- Screen title in the toolbar -->
    <style name="Ws.Text.Title" parent="Ws.Text.SemiBold">
        <item name="android:textSize">@dimen/_17ssp</item>
    </style>
    <!-- Section heading -->
    <style name="Ws.Text.Section" parent="Ws.Text.SemiBold">
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    <style name="Ws.Text.CardTitle" parent="Ws.Text.SemiBold">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="Ws.Text.Body" parent="Ws.Text.Medium">
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>
    <style name="Ws.Text.Caption">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@color/ws_text_secondary</item>
    </style>
    <style name="Ws.Text.Label" parent="Ws.Text.Medium">
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:textColor">@color/ws_text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Ws.Text.Badge" parent="Ws.Text.SemiBold">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:paddingStart">@dimen/_8sdp</item>
        <item name="android:paddingEnd">@dimen/_8sdp</item>
        <item name="android:paddingTop">@dimen/_3sdp</item>
        <item name="android:paddingBottom">@dimen/_3sdp</item>
        <item name="android:background">@drawable/ws_badge_bg</item>
    </style>

    <!-- Card (MaterialCardView): white, rounded, thin grey stroke, light elevation -->
    <style name="Widget.Ws.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/_12sdp</item>
        <item name="cardElevation">@dimen/_2sdp</item>
        <item name="strokeColor">@color/ws_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Segmented control (MaterialButtonToggleGroup + MaterialButton) -->
    <style name="Widget.Ws.Segment.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@color/ws_segment_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/ws_segment_bg</item>
        <item name="strokeColor">@color/ws_card_stroke</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/_34sdp</item>
        <item name="cornerRadius">@dimen/_10sdp</item>
        <item name="rippleColor">@color/ws_azure</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Ws.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/ws_primary</item>
        <item name="cornerRadius">@dimen/_10sdp</item>
        <item name="android:minHeight">@dimen/_38sdp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Ws.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ws_primary</item>
        <item name="strokeColor">@color/ws_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/_10sdp</item>
        <item name="android:minHeight">@dimen/_38sdp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Ws.Button.OutlineRed" parent="Widget.Ws.Button.Outline">
        <item name="android:textColor">@color/ws_red</item>
        <item name="strokeColor">@color/ws_red</item>
    </style>
    <style name="Widget.Ws.Button.Danger" parent="Widget.Ws.Button">
        <item name="backgroundTint">@color/ws_red</item>
    </style>
    <style name="Widget.Ws.Button.Tonal" parent="Widget.Ws.Button">
        <item name="android:textColor">@color/ws_primary</item>
        <item name="backgroundTint">@color/ws_azure</item>
    </style>

    <!-- Outlined text input -->
    <style name="Widget.Ws.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/_10sdp</item>
        <item name="boxCornerRadiusTopEnd">@dimen/_10sdp</item>
        <item name="boxCornerRadiusBottomStart">@dimen/_10sdp</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/_10sdp</item>
        <item name="boxStrokeColor">@color/ws_primary</item>
        <item name="hintTextColor">@color/ws_primary</item>
        <item name="errorTextColor">@color/ws_red</item>
        <item name="boxStrokeErrorColor">@color/ws_red</item>
    </style>
    <style name="Ws.Text.Input" parent="Ws.Text.Medium">
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>

    <!-- Floating action button -->
    <style name="Widget.Ws.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/ws_primary</item>
        <item name="tint">@color/white</item>
        <item name="fabCustomSize">@dimen/_44sdp</item>
        <item name="maxImageSize">@dimen/_22sdp</item>
        <item name="elevation">@dimen/_4sdp</item>
    </style>

    <!-- Bottom sheet (native BottomSheetDialogFragment): rounded top corners -->
    <style name="Ws.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/Ws.BottomSheet.Shape</item>
    </style>
    <style name="Ws.BottomSheet.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_16sdp</item>
        <item name="cornerSizeTopRight">@dimen/_16sdp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Ws.BottomSheetDialog" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Ws.BottomSheet</item>
    </style>

</resources>
