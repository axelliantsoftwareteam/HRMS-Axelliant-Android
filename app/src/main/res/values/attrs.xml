<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="RoundedButton">
        <attr name="text" format="string" />
        <attr name="buttonBg" format="reference" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="textFont" format="reference" />
        <attr name="isOutlineButton" format="boolean" />
        <attr name="iconVisibility" format="boolean" />
        <attr name="buttonIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="WsToolbar">
        <attr name="wsTitle" format="string" />
        <attr name="wsShowBack" format="boolean" />
        <attr name="wsActionIcon" format="reference" />
        <attr name="wsActionDescription" format="string" />
    </declare-styleable>

    <declare-styleable name="WsEmptyState">
        <attr name="wsEmptyIcon" format="reference" />
        <attr name="wsEmptyTitle" format="string" />
        <attr name="wsEmptyMessage" format="string" />
    </declare-styleable>

</resources>
