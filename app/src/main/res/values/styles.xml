<resources>

    <style name="start_gl" parent="@style/Guideline.Axelliant.Start" />

    <style name="end_gl" parent="@style/Guideline.Axelliant.End" />

    <style name="bottom_gl" parent="@style/Guideline.Axelliant.Bottom" />

    <style name="gl_bott">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="layout_constraintGuide_percent">@integer/gl_bott</item>
    </style>

    <style name="top_gl" parent="@style/Guideline.Axelliant.Top" />

    <style name="Theme.App" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorSecondary">@color/ds_primary</item>
        <item name="colorOnSecondary">@color/ds_primary</item>
        <item name="colorOnSurface">@color/ds_primary</item>
    </style>

    <style name="ShapeAppearanceOverlay.Demo" parent="@style/ShapeAppearance.Fluent2.BottomSheet">
        <item name="cornerSize">@dimen/ds_radius_md</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="CheckBoxStyle" parent="@style/Widget.Fluent2.CheckBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="titleTextStyle">@style/Text.Fluent2.Caption.Primary</item>
        <item name="buttonTint">@color/ds_text_primary</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSize10Percent" parent="">
        <item name="cornerSize">2%</item>
    </style>

    <style name="CustomDatePickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <!-- Customize your theme -->
        <item name="android:datePickerDialogTheme">@style/CustomDatePicker</item>
    </style>

    <style name="CustomDatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/sky_blue</item>
        <item name="android:calendarTextColor">@color/ds_text_primary</item>
    </style>

    <style name="my_dialog_theme" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="colorAccent">@color/ds_primary</item>                   <!--header background-->
        <item name="android:windowBackground">@color/ds_neutral_white</item>     <!--calendar background-->
        <item name="android:colorControlActivated">@color/ds_primary</item> <!--selected day-->
        <item name="android:textColorPrimary">@color/ds_text_primary</item> <!--days of the month-->
        <item name="android:textColorSecondary">@color/ds_primary</item>    <!--days of the week-->
    </style>

    <style name="ThemeOverlay_Demo_BottomSheetDialog" parent="@style/ThemeOverlay.Fluent2.BottomSheetDialog" />
    <style name="Widget.Demo.BottomSheet" parent="@style/Widget.Fluent2.BottomSheet" />

    <!-- this is for your dialog. To make round corners -->
    <style name="alert_dialog_round_corners" parent="@style/Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/alert_dialog_button_style</item>
    </style>
    <!-- this one is for your buttons. To make them NOT TRANSPARENT -->
    <style name="alert_dialog_button_style" parent="">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@drawable/alert_dialog_button_background</item>
        <item name="android:layout_gravity">center</item>
    </style>
<style name="MyDatePickerTheme"
        parent="ThemeOverlay.MaterialComponents.MaterialCalendar">

        <item name="colorPrimary">@color/sky_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>

    </style>


</resources>
