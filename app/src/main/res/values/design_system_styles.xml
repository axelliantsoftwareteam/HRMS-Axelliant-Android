<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Axelliant" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Axelliant.Display" parent="@style/TextAppearance.Axelliant">
        <item name="android:textSize">@dimen/ds_text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Axelliant.Heading" parent="@style/TextAppearance.Axelliant">
        <item name="android:textSize">@dimen/ds_text_heading</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Axelliant.Title" parent="@style/TextAppearance.Axelliant">
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Axelliant.Subheading" parent="@style/TextAppearance.Axelliant">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">@dimen/ds_text_subheading</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Axelliant.Body" parent="@style/TextAppearance.Axelliant">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Axelliant.Caption" parent="@style/TextAppearance.Axelliant">
        <item name="android:textColor">@color/ds_text_muted</item>
        <item name="android:textSize">@dimen/ds_text_caption</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Fluent2" parent="@style/TextAppearance.Axelliant" />
    <style name="TextAppearance.Fluent2.Display" parent="@style/TextAppearance.Axelliant.Display" />
    <style name="TextAppearance.Fluent2.Heading" parent="@style/TextAppearance.Axelliant.Heading" />
    <style name="TextAppearance.Fluent2.Title" parent="@style/TextAppearance.Axelliant.Title" />
    <style name="TextAppearance.Fluent2.Subheading" parent="@style/TextAppearance.Axelliant.Subheading" />
    <style name="TextAppearance.Fluent2.Body" parent="@style/TextAppearance.Axelliant.Body" />
    <style name="TextAppearance.Fluent2.Caption" parent="@style/TextAppearance.Axelliant.Caption" />

    <style name="Text.Axelliant">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Text.Axelliant.Display" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Display</item>
    </style>

    <style name="Text.Axelliant.Heading" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Heading</item>
    </style>

    <style name="Text.Axelliant.Title" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Title</item>
    </style>

    <style name="Text.Axelliant.Subheading" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Subheading</item>
    </style>

    <style name="Text.Axelliant.Body" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Body</item>
    </style>

    <style name="Text.Axelliant.Caption" parent="@style/Text.Axelliant">
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Caption</item>
    </style>

    <style name="Text.Axelliant.FormLabel" parent="@style/Text.Axelliant.Subheading">
        <item name="android:textColor">@color/ds_text_secondary</item>
    </style>

    <style name="Text.Fluent2" parent="@style/Text.Axelliant" />
    <style name="Text.Fluent2.Display" parent="@style/Text.Axelliant.Display" />
    <style name="Text.Fluent2.Heading" parent="@style/Text.Axelliant.Heading" />
    <style name="Text.Fluent2.Title" parent="@style/Text.Axelliant.Title" />
    <style name="Text.Fluent2.Subheading" parent="@style/Text.Axelliant.Subheading" />
    <style name="Text.Fluent2.Body" parent="@style/Text.Axelliant.Body" />
    <style name="Text.Fluent2.Caption" parent="@style/Text.Axelliant.Caption" />
    <style name="Text.Fluent2.FormLabel" parent="@style/Text.Axelliant.FormLabel" />

    <style name="Widget.Fluent2.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Fluent2.Body</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Layout" />
    <style name="Layout.Axelliant" />

    <style name="Layout.Axelliant.Screen">
        <item name="android:background">@color/ds_background</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="Layout.Fluent2" parent="@style/Layout.Axelliant" />
    <style name="Layout.Fluent2.Screen" parent="@style/Layout.Axelliant.Screen" />

    <style name="Guideline" />
    <style name="Guideline.Axelliant" />

    <style name="Guideline.Axelliant.Start">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="layout_constraintGuide_percent">@integer/app_gl_left</item>
    </style>

    <style name="Guideline.Axelliant.End">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="layout_constraintGuide_percent">@integer/app_gl_right</item>
    </style>

    <style name="Guideline.Axelliant.Top">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="layout_constraintGuide_percent">@integer/app_gl_top</item>
    </style>

    <style name="Guideline.Axelliant.Bottom">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="layout_constraintGuide_percent">@integer/app_gl_bottom</item>
    </style>

    <style name="Guideline.Fluent2" parent="@style/Guideline.Axelliant" />
    <style name="Guideline.Fluent2.Start" parent="@style/Guideline.Axelliant.Start" />
    <style name="Guideline.Fluent2.End" parent="@style/Guideline.Axelliant.End" />
    <style name="Guideline.Fluent2.Top" parent="@style/Guideline.Axelliant.Top" />
    <style name="Guideline.Fluent2.Bottom" parent="@style/Guideline.Axelliant.Bottom" />

    <style name="Widget.Axelliant" />
    <style name="Widget.Axelliant.Button" />

    <style name="Widget.Axelliant.InputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/ds_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_lg</item>
        <item name="boxStrokeColor">@color/ds_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/_1sdp</item>
        <item name="boxStrokeWidthFocused">@dimen/_1sdp</item>
        <item name="hintTextColor">@color/ds_input_hint</item>
        <item name="errorTextColor">@color/ds_error</item>
        <item name="startIconTint">@color/ds_text_muted</item>
        <item name="endIconTint">@color/ds_text_muted</item>
    </style>

    <style name="Widget.Axelliant.InputEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ds_input_height</item>
        <item name="android:paddingStart">@dimen/ds_space_12</item>
        <item name="android:paddingEnd">@dimen/ds_space_12</item>
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Body</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textColorHint">@color/ds_text_muted</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Axelliant.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Subheading</item>
        <item name="android:textColor">@color/ds_button_primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="backgroundTint">@color/ds_button_primary_background</item>
        <item name="cornerRadius">@dimen/ds_radius_lg</item>
        <item name="iconTint">@color/ds_button_primary_text</item>
        <item name="rippleColor">@color/ds_primary_pressed</item>
    </style>

    <style name="Widget.Axelliant.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Subheading</item>
        <item name="android:textColor">@color/ds_button_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="backgroundTint">@color/ds_button_secondary_background</item>
        <item name="cornerRadius">@dimen/ds_radius_lg</item>
        <item name="strokeColor">@color/ds_outline</item>
        <item name="strokeWidth">@dimen/_1sdp</item>
        <item name="iconTint">@color/ds_button_secondary_text</item>
    </style>

    <style name="Widget.Axelliant.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Axelliant.Subheading</item>
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="iconTint">@color/ds_primary</item>
    </style>

