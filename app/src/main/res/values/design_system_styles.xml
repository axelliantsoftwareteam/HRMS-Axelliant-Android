    <style name="Widget.Fluent2.InputLayout" parent="@style/Widget.Axelliant.InputLayout" />
    <style name="Widget.Fluent2.InputEditText" parent="@style/Widget.Axelliant.InputEditText" />
    <style name="Widget.Fluent2.Button" parent="@style/Widget.Axelliant.Button" />
    <style name="Widget.Fluent2.Button.Primary" parent="@style/Widget.Axelliant.Button.Primary" />
    <style name="Widget.Fluent2.Button.Secondary" parent="@style/Widget.Axelliant.Button.Secondary" />
    <style name="Widget.Fluent2.Button.Text" parent="@style/Widget.Axelliant.Button.Text" />

    <style name="Widget.Axelliant.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_lg</item>
        <item name="cardElevation">@dimen/ds_card_elevation</item>
        <item name="strokeColor">@color/ds_outline</item>
        <item name="strokeWidth">@dimen/_1sdp</item>
    </style>

    <style name="Widget.Axelliant.IconButton" parent="Widget.MaterialComponents.Button.Icon">
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:text"></item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/ds_text_primary</item>
    </style>

    <style name="ShapeAppearance" />
    <style name="ShapeAppearance.Axelliant" />

    <style name="ShapeAppearance.Axelliant.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_md</item>
    </style>

    <style name="Widget.Axelliant.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Axelliant.BottomSheet</item>
    </style>

