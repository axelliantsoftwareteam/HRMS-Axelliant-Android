<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/prof_hero_bg"
    android:elevation="@dimen/_3sdp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/_18sdp">

    <FrameLayout
        android:layout_width="@dimen/_68sdp"
        android:layout_height="@dimen/_68sdp"
        android:background="@drawable/ws_circle_bg"
        android:padding="@dimen/_2sdp">

        <ImageView
            android:id="@+id/prof_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/prof_hero_name"
            style="@style/Ws.Text.SemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/_15ssp" />

        <TextView
            android:id="@+id/prof_hero_designation"
            style="@style/Ws.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/prof_hero_department"
            style="@style/Ws.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:alpha="0.85"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
