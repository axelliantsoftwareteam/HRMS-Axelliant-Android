<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/infoRowRoot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/infoIcon"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:contentDescription="@null"
            app:tint="@color/ds_text_secondary" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/infoLabel"
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="0.9"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/text_size_10" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/infoValue"
            style="@style/Text.InternalApps.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1.1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>

    <View
        android:id="@+id/infoDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/ds_outline" />
</LinearLayout>

