<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_text_primary">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="@dimen/_220sdp"
        android:layout_height="@dimen/_220sdp"
        android:layout_gravity="center"
        android:background="@drawable/bg_product_scanner_frame" />

    <LinearLayout
        android:id="@+id/scannerStatusContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_20sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/bg_ask_ai_panel"
            android:contentDescription="@string/back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ds_text_primary" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/receiving_scan_receipt"
            android:textColor="@color/ia_white" />

        <Space
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000814"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/statusText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/receiving_scanner_align_code"
            android:textColor="@color/ia_white"
            tools:text="@string/receiving_scanner_align_code" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/retryButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="@string/ask_ai_scanner_retry"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scannedReceiptPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_filter_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_14sdp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/receiving_scanned_receipt_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_16ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/scannedSummaryText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:textColor="@color/ds_text_secondary"
            tools:text="LA | Purchase Order | PO-00000028 | 09/10/2026" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/receiving_scanned_signature_title"
            android:textColor="@color/ds_text_primary" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:layout_marginTop="@dimen/ds_space_6"
            android:background="@drawable/bg_filter_field">

            <com.axelliant.hris.features.warehouse.presentation.SignaturePadView
                android:id="@+id/signaturePad"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/signatureHintText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/receiving_scanned_signature_hint"
                android:textColor="@color/ds_text_muted" />
        </FrameLayout>

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/clearSignatureButton"
            style="@style/Widget.Fluent2.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ds_button_height"
            android:layout_gravity="end"
            android:text="@string/receiving_scanned_clear_signature" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/receiving_scanned_photo_title"
            android:textColor="@color/ds_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/galleryButton"
                style="@style/Widget.Fluent2.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/ds_button_height"
                android:layout_weight="1"
                android:text="@string/receiving_scanned_gallery"
                app:icon="@drawable/photo_ai"
                app:iconSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/ds_space_8"
                android:layout_height="1dp" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/cameraButton"
                style="@style/Widget.Fluent2.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/ds_button_height"
                android:layout_weight="1"
                android:text="@string/receiving_scanned_camera"
                app:icon="@drawable/ic_qr_scan"
                app:iconSize="@dimen/_14sdp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/selectedImagePreview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_96sdp"
            android:layout_marginTop="@dimen/ds_space_8"
            android:background="@drawable/bg_filter_field"
            android:contentDescription="@string/accessibility_image_preview"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/attachmentStatusText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="@string/receiving_scanned_no_photo"
            android:textColor="@color/ds_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:gravity="end"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/cancelButton"
                style="@style/Widget.Fluent2.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_button_height"
                android:text="@string/cancel" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/createReceiptButton"
                style="@style/Widget.Fluent2.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_button_height"
                android:layout_marginStart="@dimen/_12sdp"
                android:text="@string/receiving_create_receipt" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
