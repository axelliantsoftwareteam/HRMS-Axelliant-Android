<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_screen_bg"
    android:orientation="vertical">

    <com.axelliant.hris.ui.WsToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:wsTitle="@string/prof_title" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/prof_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_11sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingEnd="@dimen/_11sdp"
                android:paddingBottom="@dimen/_30sdp">

                <!-- Shown when there is nothing to display and the load failed. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/prof_unavailable"
                    style="@style/Widget.Ws.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/_16sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2E888A8C">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_11sdp">

                        <TextView
                            style="@style/Ws.Text.SemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/prof_unavailable"
                            android:textSize="@dimen/_11ssp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/prof_try_again"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/prof_try_again"
                            android:textAllCaps="false"
                            android:textColor="@color/ws_primary"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sections are built by ProfileRenderer. -->
                <LinearLayout
                    android:id="@+id/prof_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
