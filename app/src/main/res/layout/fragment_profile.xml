<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_neutral_white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/tv_profile_title"
                style="@style/Text.Fluent2.Subheading.Primary.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="My Profile" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/tv_profile_subtitle"
                style="@style/Text.Fluent2.Body.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="Personal information, employment record, and certifications." />

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/ds_neutral_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/tv_employee_name"
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="Employee" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/tv_employee_designation"
                        style="@style/Text.Fluent2.Body.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="start"
                        android:text="Designation" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/tv_employee_meta"
                            style="@style/Text.Fluent2.Body.Primary.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="Employee code · Department" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/tv_contact_meta"
                            style="@style/Text.Fluent2.Body.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="start"
                            android:text="Email · Phone · Company" />
                    </LinearLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/ds_neutral_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="Personal and employment" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/tv_personal_block"
                        style="@style/Text.Fluent2.Body.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="start"
                        android:lineSpacingExtra="2dp"
                        tools:text="Father name: Example\nDate of birth: 01-Jan-1990\nGender: Male\nCNIC: XXXXX-XXXXXXX-X\nManager: Example Manager\nAddress: Example address" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/ds_neutral_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                style="@style/Text.Fluent2.Subheading.Primary.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:text="Certifications" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/tv_certification_summary"
                                style="@style/Text.Fluent2.Body.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="start"
                                android:text="0 tracked · 0 renewal due" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_certifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_profile_certification" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/tv_empty_certifications"
                        style="@style/Text.Fluent2.Body.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="start"
                        android:text="No certifications have been added yet."
                        android:visibility="gone" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/ds_neutral_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="Add certification" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Body.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:text="Track expiry, renewal, and ownership for your professional credentials." />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/et_certification_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Certification name" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/et_certification_authority"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Issuing authority" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/et_certification_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Credential ID" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                android:id="@+id/et_issue_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:hint="Issue date" />
                        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                android:id="@+id/et_expiry_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:hint="Expiry date" />
                        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>
                    </LinearLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppCheckboxView
                        android:id="@+id/cb_renewal_required"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:checked="true"
                        android:text="Renewal required" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/et_certification_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Credential URL" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/et_certification_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:hint="Notes"
                            android:inputType="textMultiLine"
                            android:minLines="3" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppButtonView
                        android:id="@+id/btn_add_certification"
                        style="@style/ButtonTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Add certification" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
