<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_10"
        android:alpha="0.55"
        android:background="@drawable/bg_filter_field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/workflowTitleText"
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/quote_workflow_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_14ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/closeButton"
            style="@style/Widget.InternalApps.Dashboard.IconButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:contentDescription="@string/close"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:icon="@drawable/ia_ic_filter_close"
            app:iconGravity="textStart"
            app:noBackground="true" />
    </LinearLayout>

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/quoteNumberText"
        style="@style/Text.InternalApps.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        android:fontFamily="@font/poppins_medium"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16"
        android:textColor="@color/ds_text_primary"
        android:textSize="@dimen/_10ssp"
        tools:text="Q-00000247" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_12"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:background="@color/ds_outline" />

    <LinearLayout
        android:id="@+id/workflowSummaryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <FrameLayout
            android:layout_width="@dimen/_54sdp"
            android:layout_height="@dimen/_54sdp">

            <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
                android:id="@+id/workflowProgressIndicator"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                app:indicatorColor="@color/ds_primary"
                app:indicatorDirectionCircular="clockwise"
                app:indicatorInset="0dp"
                app:indicatorSize="@dimen/_50sdp"
                app:trackColor="@color/ds_outline"
                app:trackThickness="@dimen/_3sdp"
                tools:progress="33" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/workflowProgressText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_9ssp"
                tools:text="1/3" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/workflowCompletedText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_10ssp"
                tools:text="1 of 3 completed" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/workflowCurrentText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_9ssp"
                tools:text="Current: Customer Approval" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_12"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:background="@color/ds_outline" />

    <LinearLayout
        android:id="@+id/workflowCompleteNoticeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_14"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:background="@drawable/bg_quote_workflow_notice_completed"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_12"
        android:paddingTop="@dimen/ds_space_10"
        android:paddingEnd="@dimen/ds_space_12"
        android:paddingBottom="@dimen/ds_space_10"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workflow_step_approved" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/quote_workflow_all_stages_completed"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:text="@string/quote_workflow_all_stages_body"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_8ssp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/workflowStepsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_14"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_space_14"
        android:paddingEnd="@dimen/ds_space_16"
        android:paddingBottom="@dimen/ds_space_24"
        tools:listitem="@layout/item_quote_workflow_step" />
</LinearLayout>




