<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_filter_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_filter_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_8sdp">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/receiving_create_receipt_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_16ssp" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ia_ic_filter_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_14sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.InternalApps.Card"
                app:cardElevation="0dp"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_10">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Subheading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_info_title"
                        android:textColor="@color/ds_text_primary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/receiving_create_info_subtitle"
                        android:textColor="@color/ds_text_secondary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_warehouse_required"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_9ssp" />

                    <include
                        android:id="@+id/warehouseFieldInclude"
                        layout="@layout/layout_warehouse_inventory_select_field" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_type_required"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_9ssp" />

                    <include
                        android:id="@+id/typeFieldInclude"
                        layout="@layout/layout_warehouse_inventory_select_field" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/sourceLabel"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_purchase_order_required"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_9ssp" />

                    <include
                        android:id="@+id/purchaseOrderFieldInclude"
                        layout="@layout/layout_warehouse_inventory_select_field" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                        android:id="@+id/customerIdEditText"
                        style="@style/Widget.InternalApps.InputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:hint="@string/receiving_create_customer_hint"
                        android:inputType="text"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_expected_date"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_9ssp" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                        android:id="@+id/expectedDateEditText"
                        style="@style/Widget.InternalApps.InputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:hint="@string/receiving_create_expected_date_hint"
                        android:inputType="date" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/receiving_create_notes"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_9ssp" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                        android:id="@+id/notesEditText"
                        style="@style/Widget.InternalApps.InputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:hint="@string/receiving_create_notes_hint"
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.InternalApps.Card"
                android:layout_marginTop="@dimen/ds_space_10"
                app:cardElevation="0dp"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_10">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                style="@style/Text.InternalApps.Subheading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/receiving_create_items_title"
                                android:textColor="@color/ds_text_primary" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/itemsSubtitleText"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/receiving_create_items_po_subtitle"
                                android:textColor="@color/ds_text_secondary" />
                        </LinearLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppButtonView
                            android:id="@+id/addLineButton"
                            style="@style/Widget.Fluent2.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/ds_button_height"
                            android:text="@string/receiving_create_add_line"
                            android:textSize="@dimen/_9ssp"
                            app:icon="@drawable/ia_ic_add"
                            app:iconSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/itemsEmptyText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_72sdp"
                        android:gravity="center"
                        android:text="@string/receiving_create_items_empty_po"
                        android:textColor="@color/ds_text_secondary" />

                    <LinearLayout
                        android:id="@+id/manualLineContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_10"
                        android:background="@color/ds_surface_variant"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_8"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <include
                            android:id="@+id/productFieldInclude"
                            layout="@layout/layout_warehouse_inventory_select_field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/quantityEditText"
                            style="@style/Widget.InternalApps.InputEditText"
                            android:layout_width="@dimen/_74sdp"
                            android:layout_height="@dimen/ds_input_height"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:hint="@string/receiving_create_qty"
                            android:inputType="numberDecimal" />

                        <ImageButton
                            android:id="@+id/removeLineButton"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_marginStart="@dimen/ds_space_6"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/remove"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/ia_ic_filter_close" />
                    </LinearLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_70sdp"
        android:background="@drawable/bg_filter_footer_border"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp">

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/cancelButton"
            style="@style/Widget.Fluent2.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ds_button_height"
            android:text="@string/cancel" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/createButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ds_button_height"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="@string/receiving_create_receipt" />
    </LinearLayout>
</LinearLayout>
