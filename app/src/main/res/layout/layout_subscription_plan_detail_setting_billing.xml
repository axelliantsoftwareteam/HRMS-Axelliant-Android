<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/bg_subscription_detail_icon_tile">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar"
            app:tint="@color/ds_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_billing_frequency"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/text_size_9" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/billingFrequencyValue"
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/text_size_9" />
    </LinearLayout>
</LinearLayout>
