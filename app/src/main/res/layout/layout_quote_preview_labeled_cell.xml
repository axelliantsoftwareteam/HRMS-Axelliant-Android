<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/cellLabel"
        style="@style/Text.InternalApps.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ds_text_muted" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/cellValue"
        style="@style/Text.InternalApps.Subheading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/ds_text_primary" />
</LinearLayout>

