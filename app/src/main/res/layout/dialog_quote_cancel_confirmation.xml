<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ia_ds_radius_md"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_20sdp"
        android:paddingTop="@dimen/_24sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingBottom="@dimen/_20sdp">

        <FrameLayout
            android:id="@+id/cancelWarningIconContainer"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/bg_quote_cancel_warning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/cancelWarningIcon"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_quote_cancel_warning" />
        </FrameLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/cancelConfirmMessage"
            style="@style/TextAppearance.InternalApps.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:gravity="center"
            android:text="@string/quote_cancel_confirm_message"
            android:textColor="@color/ds_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cancelWarningIconContainer" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/cancelQuoteYesButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:text="@string/quote_cancel_yes"
            app:layout_constraintEnd_toStartOf="@id/cancelQuoteNoButton"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cancelConfirmMessage" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/cancelQuoteNoButton"
            style="@style/Widget.Fluent2.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/quote_cancel_no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cancelQuoteYesButton"
            app:layout_constraintTop_toTopOf="@id/cancelQuoteYesButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.axelliant.hris.ui.designsystem.components.AppCardView>

