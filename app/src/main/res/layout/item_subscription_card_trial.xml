<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_10sdp"
    android:background="@drawable/bg_subscription_card"
    android:elevation="@dimen/_2sdp"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_12ssp"
            android:text="SUB-1047" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Caption"
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_subscription_status_trial"
            android:gravity="center"
            android:textColor="@color/ds_primary"
            android:textSize="@dimen/_10ssp"
            android:text="@string/subscription_status_trial" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/layout_subscription_info_account_northwind" />

        <include layout="@layout/layout_subscription_info_plan_team" />

        <include layout="@layout/layout_subscription_info_price_team" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/ds_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal">

        <include layout="@layout/layout_subscription_billing_trial" />

        <include layout="@layout/layout_subscription_auto_on" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/ds_outline" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        style="@style/Text.Fluent2.Title.Primary.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/subscription_view_details"
        android:textColor="@color/ds_primary"
        android:textSize="@dimen/_10ssp" />
</LinearLayout>
