<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ws.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_14sdp">

        <LinearLayout
            android:id="@+id/exp_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/exp_cd_expand"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exp_icon"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/ws_icon_badge_bg"
                android:importantForAccessibility="no"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ws_ic_credit_card" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exp_date"
                    style="@style/Ws.Text.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/exp_status"
                    style="@style/Ws.Text.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/exp_amount"
                style="@style/Ws.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:textColor="@color/ws_purple"
                android:textSize="@dimen/_20ssp" />

            <ImageView
                android:id="@+id/exp_chevron"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ws_ic_expand_more"
                app:tint="@color/black" />
        </LinearLayout>

        <include
            android:id="@+id/exp_detail"
            layout="@layout/exp_view_claim_detail" />

        <LinearLayout
            android:id="@+id/exp_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exp_btn_delete"
                style="@style/Widget.Ws.Button.OutlineRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exp_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exp_btn_edit"
                style="@style/Widget.Ws.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:text="@string/exp_edit" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
