<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    style="@style/Layout.Fluent2.Screen" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />
    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:showBackButton="true"
        app:showSearchButton="false"
        app:titleText="@string/add_purchase_order_title"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_8"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/ds_space_8"
        app:layout_constraintBottom_toTopOf="@id/footerCard"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.FormLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_purchase_order_select_quote" />

            <LinearLayout
                android:id="@+id/quoteField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_input_height"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_quote_search"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_8">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/quoteValueText"
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/add_purchase_order_select_quote_hint"
                    android:textColor="@color/ds_text_muted" />

                <ImageView
                    android:id="@+id/clearQuoteButton"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@string/add_purchase_order_clear_quote_cd"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/ds_text_muted" />

                <ImageView
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ia_ic_filter_down" />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/quoteFieldError"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:textColor="@color/ds_error"
                android:visibility="gone" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.FormLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:text="@string/add_purchase_order_select_sales_orders" />

            <LinearLayout
                android:id="@+id/saleOrderField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_input_height"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_quote_search"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_8">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ia_ic_search"
                    app:tint="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/saleOrderValueText"
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/add_purchase_order_select_sales_order_hint"
                    android:textColor="@color/ds_text_muted" />

                <ImageView
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ia_ic_filter_down" />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/saleOrderFieldError"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:textColor="@color/ds_error"
                android:visibility="gone" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/saleOrderHelperText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/add_purchase_order_select_quote_helper"
                android:textColor="@color/ds_text_muted"
                android:textStyle="italic" />

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:id="@+id/saleOrderInfoCard"
                style="@style/Widget.InternalApps.Card"
                android:layout_marginTop="@dimen/ds_space_12"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/purchase_order_card_stroke"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/saleOrderInfoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_add_po_info_header"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ds_space_12"
                        android:paddingVertical="@dimen/ds_space_10">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/add_purchase_order_sales_order_information"
                            android:textAllCaps="true"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="@dimen/_11ssp" />

                        <ImageView
                            android:id="@+id/saleOrderInfoChevron"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:contentDescription="@string/add_purchase_order_collapse_info_cd"
                            android:src="@drawable/ic_chevron_up"
                            app:tint="@color/ds_text_primary" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/saleOrderInfoBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/saleOrderInfoEmptyText"
                            style="@style/Text.InternalApps.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/ds_space_20"
                            android:text="@string/add_purchase_order_no_sales_order_found"
                            android:textColor="@color/ds_text_muted" />

                        <LinearLayout
                            android:id="@+id/saleOrderInfoContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_12"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:text="@string/add_purchase_order_sales_order_number"
                                        android:textColor="@color/ds_text_muted" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/infoSaleOrderNumberText"
                                        style="@style/Text.InternalApps.Body"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:textColor="@color/ds_text_primary"
                                        tools:text="SO-00000149" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:text="@string/add_purchase_order_quote_number"
                                        android:textColor="@color/ds_text_muted" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/infoQuoteNumberText"
                                        style="@style/Text.InternalApps.Body"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:textColor="@color/ds_text_primary"
                                        tools:text="Q-00000289" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_10"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:text="@string/add_purchase_order_customer"
                                        android:textColor="@color/ds_text_muted" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/infoCustomerText"
                                        style="@style/Text.InternalApps.Body"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:textColor="@color/ds_text_primary"
                                        tools:text="Sagittarius" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:text="@string/add_purchase_order_amount"
                                        android:textColor="@color/ds_text_muted" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/infoAmountText"
                                        style="@style/Text.InternalApps.Body"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:textColor="@color/ds_primary"
                                        tools:text="$112.97" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_12"
                                android:gravity="top"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_18sdp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_profile_location"
                                    app:tint="@color/ds_primary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_8"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:text="@string/add_purchase_order_billing_address"
                                        android:textColor="@color/ds_text_primary" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/billingAddressText"
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:layout_marginTop="@dimen/_2sdp"
                                        android:textColor="@color/ds_text_secondary"
                                        tools:text="Chicago, IL, USA\nChicago, Illinois\nUnited States - 11111" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_10"
                                android:gravity="top"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_18sdp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_truck"
                                    app:tint="@color/ds_primary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_8"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:text="@string/add_purchase_order_shipping_address"
                                        android:textColor="@color/ds_text_primary" />

                                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                                        android:id="@+id/shippingAddressText"
                                        style="@style/Text.InternalApps.Caption"
                                        android:layout_width="match_parent"
                                        android:layout_marginTop="@dimen/_2sdp"
                                        android:textColor="@color/ds_text_secondary"
                                        tools:text="645 Bryant St\nSan Francisco, California\nUnited States - 94107" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <LinearLayout
                android:id="@+id/productsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.FormLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/add_purchase_order_products"
                        android:textColor="@color/ds_text_primary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/selectedItemsSummaryText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ds_text_muted"
                        tools:text="Selected items: 0 / Total Qty: 0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/productsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyProductsState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:background="@drawable/bg_add_po_empty_products"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_space_10"
                    android:paddingTop="@dimen/ds_space_14"
                    android:paddingEnd="@dimen/ds_space_10"
                    android:paddingBottom="@dimen/ds_space_14">

                    <FrameLayout
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:background="@drawable/bg_sale_order_empty_product_icon">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dashboard_box"
                            app:tint="@color/ds_text_muted" />
                    </FrameLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/add_purchase_order_no_products_title"
                        android:textColor="@color/ds_text_primary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:gravity="center"
                        android:text="@string/add_purchase_order_no_products_hint"
                        android:textColor="@color/ds_text_muted" />
                </LinearLayout>

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/productsFieldError"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textColor="@color/ds_error"
                    android:visibility="gone" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/linesSummaryText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:textColor="@color/ds_text_muted"
                    tools:text="0 sales order(s) with 0 product line(s)" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.axelliant.hris.ui.designsystem.components.AppCardView
        android:id="@+id/footerCard"
        style="@style/Widget.InternalApps.Card"
        android:layout_width="0dp"
        app:cardElevation="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:strokeColor="@color/purchase_order_card_stroke"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/add_purchase_order_subtotal"
                            android:textColor="@color/ds_text_muted" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/subtotalText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ds_text_primary"
                            tools:text="$0.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/add_purchase_order_tax"
                            android:textColor="@color/ds_text_muted" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/taxText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ds_text_primary"
                            tools:text="$0.00" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/add_purchase_order_shipping"
                            android:textColor="@color/ds_text_muted" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/shippingText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ds_text_primary"
                            tools:text="$0.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/add_purchase_order_grand_total"
                            android:textColor="@color/ds_text_primary" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/grandTotalText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/ds_text_primary"
                            tools:text="$0.00" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/cancelButton"
                    style="@style/Widget.InternalApps.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ds_button_height"
                    android:layout_marginEnd="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:backgroundTint="@color/ds_surface_variant"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/quotes_navy"
                    app:cornerRadius="@dimen/ia_ds_radius_md"
                    app:strokeWidth="0dp" />

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/createButton"
                    style="@style/Widget.InternalApps.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ds_button_height"
                    android:layout_weight="1.4"
                    android:alpha="0.45"
                    android:backgroundTint="@color/quotes_navy"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/add_purchase_order_create"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_on_primary"
                    app:cornerRadius="@dimen/ia_ds_radius_md"
                    app:icon="@drawable/ic_cart_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ds_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </com.axelliant.hris.ui.designsystem.components.AppCardView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sale_order_loading_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


