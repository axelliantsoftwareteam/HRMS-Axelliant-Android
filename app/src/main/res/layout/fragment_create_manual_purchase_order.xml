<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    style="@style/Layout.Fluent2.Screen" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:searchIcon="@drawable/ia_ic_search"
        app:showBackButton="true"
        app:showSearchButton="true"
        app:titleText="@string/create_manual_po_title"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/ds_space_8"
        android:background="@color/ds_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/ds_space_8"
        app:layout_constraintBottom_toTopOf="@id/footerContainer"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/ds_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/create_manual_po_products_information"
                    android:textColor="@color/quotes_navy" />

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/addProductButton"
                    style="@style/Widget.Fluent2.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:text="@string/create_manual_po_add_product"
                    android:textAllCaps="false"
                    android:textSize="@dimen/_9ssp"
                    app:icon="@drawable/ia_ic_add"
                    app:iconPadding="@dimen/_4sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:iconSize="@dimen/ds_button_inline_icon_size"
                    app:iconTint="@color/ds_on_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyProductsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_72"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/ds_space_16"
                android:paddingTop="@dimen/ds_space_24"
                android:paddingEnd="@dimen/ds_space_16"
                android:paddingBottom="@dimen/ds_space_24">

                <FrameLayout
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="@dimen/_48sdp"
                    android:background="@drawable/bg_sale_order_empty_product_icon">

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_box"
                        app:tint="@color/ds_text_muted" />
                </FrameLayout>

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_10"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/create_manual_po_no_products_title"
                    android:textColor="@color/quotes_navy" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:gravity="center"
                    android:text="@string/create_manual_po_no_products_hint"
                    android:textColor="@color/ds_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/productsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/addMoreItemsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_smart_quote_add_more_products"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/ds_space_14"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_document_add"
                    app:tint="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:text="@string/create_manual_po_add_more_items"
                    android:textColor="@color/ds_text_muted" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/ds_space_8"
        app:layout_constraintBottom_toBottomOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/ds_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_manual_po_subtotal"
                android:textColor="@color/ds_text_muted" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/subtotalText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_primary"
                tools:text="$0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_manual_po_shipping"
                android:textColor="@color/ds_text_muted" />

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:contentDescription="@string/create_manual_po_shipping_info_cd"
                android:src="@drawable/ic_info_outline"
                app:tint="@color/ds_text_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/shippingText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_primary"
                tools:text="$0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_manual_po_tax"
                android:textColor="@color/ds_text_muted" />

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:contentDescription="@string/create_manual_po_tax_info_cd"
                android:src="@drawable/ic_info_outline"
                app:tint="@color/ds_text_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/taxText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_primary"
                tools:text="$0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/create_manual_po_grand_total"
                android:textColor="@color/ds_text_primary" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/grandTotalText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ds_primary"
                tools:text="$0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/cancelButton"
                style="@style/Widget.Fluent2.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/ds_button_height"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/ds_text_primary"
                app:cornerRadius="@dimen/ds_radius_md"
                app:strokeColor="@color/ds_outline" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/createButton"
                style="@style/Widget.Fluent2.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/ds_button_height"
                android:layout_weight="1"
                android:text="@string/add_purchase_order_create"
                android:textAllCaps="false"
                android:textSize="@dimen/_9ssp"
                app:icon="@drawable/ic_cart_add"
                app:iconPadding="@dimen/_4sdp"
                app:iconSize="@dimen/ds_button_inline_icon_size"
                app:iconTint="@color/ds_on_primary" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sale_order_loading_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


