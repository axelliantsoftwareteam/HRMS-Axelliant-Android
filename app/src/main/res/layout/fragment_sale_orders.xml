<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        style="@style/Layout.Fluent2.Screen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/startGuideline"
            style="@style/Guideline.Fluent2.Start"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/endGuideline"
            style="@style/Guideline.Fluent2.End"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/topGuideline"
            style="@style/Guideline.Fluent2.Top"
            android:orientation="horizontal" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottomGuideline"
            style="@style/Guideline.Fluent2.Bottom"
            android:orientation="horizontal" />

        <com.axelliant.hris.ui.designsystem.components.AppTopBarView
            android:id="@+id/appTopBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            app:titleText="@string/sale_orders_title"
            app:showSearchButton="true"
            app:searchIcon="@drawable/ia_ic_search"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/topGuideline" />


        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/totalEntriesText"
            style="@style/Text.InternalApps.Display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:textSize="@dimen/text_size_15"
            android:textColor="@color/ds_text_muted"
            android:fontFamily="@font/poppins_bold"
            android:textAlignment="textStart"
            tools:text="0 Total Entries"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/searchInputLayout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statusFilterRecycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingEnd="@dimen/ds_space_8"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/totalEntriesText" />

        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
            android:id="@+id/searchInputLayout"
            style="@style/Widget.InternalApps.InputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:visibility="visible"
            app:boxBackgroundMode="none"
            app:endIconDrawable="@drawable/ia_ic_filter_close"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/appTopBar"
            app:startIconDrawable="@drawable/ia_ic_search">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                android:id="@+id/searchEditText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quote_search"
                android:hint="@string/sale_orders_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="@dimen/ds_input_height"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_12"
                android:textColorHint="@color/ds_text_muted" />
        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/listTopBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="statusFilterRecycler,searchInputLayout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/saleOrdersRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ds_space_12"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/ds_space_72"
            app:layout_constraintBottom_toTopOf="@id/paginationShimmerContainer"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/listTopBarrier" />

        <LinearLayout
            android:id="@+id/paginationShimmerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline" />

        <LinearLayout
            android:id="@+id/shimmerContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ds_space_12"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/listTopBarrier" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/emptyStateText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sale_orders_empty"
            android:textColor="@color/ds_text_secondary"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/listTopBarrier"
            app:layout_constraintVertical_bias="0.35" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/errorStateText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sale_orders_error"
            android:textColor="@color/ds_error"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/listTopBarrier" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrim, action row, and FAB are siblings of contentContainer so blur doesn't affect them -->

    <View
        android:id="@+id/fabMenuScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/purchase_order_fab_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/addSaleOrderActionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/createSaleOrderFab"
        app:layout_constraintEnd_toEndOf="@id/createSaleOrderFab">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/addSaleOrderLabel"
            style="@style/Text.InternalApps.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ds_space_10"
            android:background="@drawable/bg_purchase_order_fab_label"
            android:elevation="@dimen/_2sdp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/ds_space_14"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_space_14"
            android:paddingBottom="@dimen/ds_space_8"
            android:text="@string/sale_orders_create"
            android:textColor="@color/ds_text_primary" />

        <com.axelliant.hris.ui.designsystem.components.AppFloatingActionButtonView
            android:id="@+id/addSaleOrderSubFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ia_ic_add"
            app:backgroundTint="@color/ds_primary"
            app:elevation="@dimen/_4sdp"
            app:fabSize="mini"
            app:tint="@color/ds_on_primary" />
    </LinearLayout>

    <com.axelliant.hris.ui.designsystem.components.AppFloatingActionButtonView
        android:id="@+id/createSaleOrderFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:layout_marginBottom="@dimen/ds_space_24"
        android:contentDescription="@string/sale_orders_create"
        android:src="@drawable/ia_ic_add"
        app:backgroundTint="@color/ds_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/ds_on_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>