<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_screen_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">

    <com.axelliant.hris.ui.WsToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        app:wsTitle="Certifications" />

    <com.axelliant.hris.ui.WsEmptyState
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        app:wsEmptyIcon="@drawable/ws_ic_info"
        app:wsEmptyMessage="This screen is being built."
        app:wsEmptyTitle="Certifications" />
</LinearLayout>
