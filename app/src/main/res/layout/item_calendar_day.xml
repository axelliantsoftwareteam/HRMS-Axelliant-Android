<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_42sdp">

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/dayText"
        style="@style/Text.Fluent2.Body.Primary.Strong"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_28sdp"
        android:gravity="center"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="18" />

    <View
        android:id="@+id/eventDot"
        android:layout_width="@dimen/_5sdp"
        android:layout_height="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:background="@drawable/bg_calendar_event_dot"
        app:layout_constraintEnd_toEndOf="@id/dayText"
        app:layout_constraintStart_toStartOf="@id/dayText"
        app:layout_constraintTop_toBottomOf="@id/dayText" />
</androidx.constraintlayout.widget.ConstraintLayout>
