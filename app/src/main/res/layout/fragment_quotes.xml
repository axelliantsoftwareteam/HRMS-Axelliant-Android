<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout.Fluent2.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/startGuideline"
            style="@style/Guideline.Fluent2.Start"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/endGuideline"
            style="@style/Guideline.Fluent2.End"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/topGuideline"
            style="@style/Guideline.Fluent2.Top"
            android:orientation="horizontal" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottomGuideline"
            style="@style/Guideline.Fluent2.Bottom"
            android:orientation="horizontal" />

        <com.axelliant.hris.ui.designsystem.components.AppTopBarView
            android:id="@+id/appTopBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/topGuideline"
            app:searchIcon="@drawable/ia_ic_search"
            app:showSearchButton="true"
            app:titleText="@string/quotes_title" />

        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
            android:id="@+id/searchInputLayout"
            style="@style/Widget.InternalApps.InputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:visibility="visible"
            app:boxBackgroundMode="none"
            app:endIconDrawable="@drawable/ia_ic_filter_close"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/appTopBar"
            app:startIconDrawable="@drawable/ia_ic_search">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                android:id="@+id/searchEditText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quote_search"
                android:hint="@string/quotes_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="@dimen/ds_input_height"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_12"
                android:textColorHint="@color/ds_text_muted" />
        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/headerBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="appTopBar,searchInputLayout" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quoteTypeTabs"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/ds_space_10"
            android:background="@drawable/bg_quote_tab_track"
            android:padding="@dimen/_3sdp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/headerBottomBarrier">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/standardTab"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_quote_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_semibold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/quotes_tab_standard"
                android:textColor="@color/ds_text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/quickTab"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/quickTab"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_medium"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/quotes_tab_quick"
                android:textColor="@color/ds_text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/standardTab"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Week / Month toggle - UNCHANGED -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_date_filters"
            android:layout_width="0dp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/rounded_bgg"
            android:padding="@dimen/_3sdp"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/headerBottomBarrier"
            tools:itemCount="2"
            tools:listitem="@layout/item_filter_pill" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statusFilterRecycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingEnd="@dimen/ds_space_8"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/rv_date_filters" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quotesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ds_space_8"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/bottom_nav_content_padding"
            app:layout_constraintBottom_toTopOf="@id/paginationShimmerContainer"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/statusFilterRecycler" />

        <LinearLayout
            android:id="@+id/paginationShimmerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline" />

        <LinearLayout
            android:id="@+id/shimmerContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ds_space_8"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/statusFilterRecycler" />

        <include
            android:id="@+id/quotesEmptyState"
            layout="@layout/layout_quotes_empty_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/statusFilterRecycler"
            app:layout_constraintVertical_bias="0.35" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/errorStateText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/quotes_error"
            android:textColor="@color/ds_error"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@id/endGuideline"
            app:layout_constraintStart_toStartOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/statusFilterRecycler" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.axelliant.hris.ui.designsystem.components.AppFloatingActionButtonView
        android:id="@+id/createQuoteFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="638dp"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:layout_marginBottom="@dimen/ds_space_16"
        android:contentDescription="@string/purchase_orders_fab_open"
        android:src="@drawable/ia_ic_add"
        app:backgroundTint="@color/ds_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/contentContainer"
        app:tint="@color/ds_on_primary" />


    <View
        android:id="@+id/quoteActionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/purchase_order_fab_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/quoteActionMenuCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_8"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/createQuoteFab"
        app:layout_constraintEnd_toEndOf="@id/createQuoteFab">

