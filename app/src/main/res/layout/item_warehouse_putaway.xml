<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.InternalApps.Card"
    android:layout_marginBottom="@dimen/ds_space_8"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="@color/ds_outline"
    app:strokeWidth="@dimen/_1sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ds_space_10">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/productText"
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/ds_text_primary"
            app:layout_constraintEnd_toStartOf="@id/quantityBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="#6 WALL BRACKET WHITE" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/quantityBadge"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:background="@drawable/bg_quote_status_submitted"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:minWidth="@dimen/_50sdp"
            android:paddingStart="@dimen/ds_space_10"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_10"
            android:paddingBottom="@dimen/ds_space_4"
            android:textColor="@color/quotes_status_submitted_text"
            android:textSize="@dimen/_7ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Qty 1" />

        <LinearLayout
            android:id="@+id/locationRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/productText">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/putaway_from_location_label"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/fromLocationText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="Inspection" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/putaway_to_location_label"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/toLocationText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="Storage" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sourceRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/locationRow"
            app:layout_constraintStart_toStartOf="@id/locationRow"
            app:layout_constraintTop_toBottomOf="@id/locationRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warehouse_label"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/warehouseText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="LA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/receiving_source_label"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/sourceText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="PO-00000028" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="@dimen/ds_space_10"
            android:background="@color/ds_outline"
            app:layout_constraintEnd_toEndOf="@id/sourceRow"
            app:layout_constraintStart_toStartOf="@id/sourceRow"
            app:layout_constraintTop_toBottomOf="@id/sourceRow" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/notesLabel"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:text="@string/putaway_notes_label"
            android:textColor="@color/ds_text_muted"
            app:layout_constraintEnd_toEndOf="@id/divider"
            app:layout_constraintStart_toStartOf="@id/divider"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/notesText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/ds_text_primary"
            app:layout_constraintEnd_toEndOf="@id/notesLabel"
            app:layout_constraintStart_toStartOf="@id/notesLabel"
            app:layout_constraintTop_toBottomOf="@id/notesLabel"
            tools:text="-" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/createdDateLabel"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:text="@string/warehouse_date_time_label"
            android:textColor="@color/ds_text_muted"
            app:layout_constraintEnd_toEndOf="@id/notesText"
            app:layout_constraintStart_toStartOf="@id/notesText"
            app:layout_constraintTop_toBottomOf="@id/notesText" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/createdDateText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/ds_text_primary"
            app:layout_constraintEnd_toEndOf="@id/createdDateLabel"
            app:layout_constraintStart_toStartOf="@id/createdDateLabel"
            app:layout_constraintTop_toBottomOf="@id/createdDateLabel"
            tools:text="Sep 03, 2026, 01:13:45 PM" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>
