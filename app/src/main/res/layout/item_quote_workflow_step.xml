<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/timelineTopLine"
        android:layout_width="@dimen/_1sdp"
        android:layout_height="0dp"
        android:background="@color/ds_outline"
        app:layout_constraintBottom_toTopOf="@id/nodeContainer"
        app:layout_constraintEnd_toEndOf="@id/nodeContainer"
        app:layout_constraintStart_toStartOf="@id/nodeContainer"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/nodeContainer"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/ds_space_10"
        android:background="@drawable/bg_quote_workflow_node_pending"
        app:layout_constraintEnd_toStartOf="@id/stepCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/stepCard">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stepStatusIcon"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ia_ic_filter_check"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/processNumberText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_9ssp"
            tools:text="2" />
    </FrameLayout>

    <View
        android:id="@+id/timelineBottomLine"
        android:layout_width="@dimen/_1sdp"
        android:layout_height="0dp"
        android:background="@color/ds_outline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/nodeContainer"
        app:layout_constraintStart_toStartOf="@id/nodeContainer"
        app:layout_constraintTop_toBottomOf="@id/nodeContainer" />

    <LinearLayout
        android:id="@+id/stepCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_12"
        android:layout_marginStart="@dimen/ds_space_10"
        android:background="@drawable/bg_quote_workflow_step_pending"
        android:elevation="@dimen/_1sdp"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_12"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_space_12"
        android:paddingBottom="@dimen/ds_space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nodeContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/processNameText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp"
                tools:text="2. Customer Approval" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/statusBadgeText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginStart="@dimen/ds_space_8"
                android:background="@drawable/bg_quote_workflow_status_pending"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:minWidth="@dimen/_62sdp"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_8"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_7ssp"
                tools:text="Upcoming" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/roleNameText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_9ssp"
            tools:visibility="visible"
            tools:text="Role name : Inside Sales Representative" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/processScreenNameText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ds_text_muted"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            tools:text="Quotation"
            tools:visibility="visible" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/timestampText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            tools:text="Jul 06, 2026, 12:06 PM"
            tools:visibility="visible" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/waitingForActionText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/quote_workflow_waiting_for_action"
            android:textColor="@color/ds_primary"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/rejectionReasonText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:background="@drawable/bg_quote_workflow_reason"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="@dimen/ds_space_10"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_space_10"
            android:paddingBottom="@dimen/ds_space_8"
            android:textColor="@color/quotes_status_rejected_text"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            tools:text="Rejected by Customer"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/actionButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/rejectButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/ds_space_6"
                android:layout_weight="1"
                android:background="@drawable/bg_quote_workflow_btn_reject"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:textColor="@color/ds_error"
                android:textSize="@dimen/_8ssp"
                tools:text="Reject" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/approveButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/ds_space_6"
                android:layout_weight="1"
                android:background="@drawable/bg_quote_workflow_btn_approve"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:textColor="@color/ia_white"
                android:textSize="@dimen/_8ssp"
                tools:text="Approve" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

