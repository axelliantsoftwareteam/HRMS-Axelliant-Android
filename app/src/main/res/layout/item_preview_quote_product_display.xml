<?xml version="1.0" encoding="utf-8"?>
<!-- UI PROTOTYPE ONLY â€” display card; tap opens actions bottom sheet -->
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.InternalApps.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_10"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="#EEF3F8"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quote_save_draft_button"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingTop="@dimen/ds_space_2"
                android:paddingEnd="@dimen/ds_space_8"
                android:paddingBottom="@dimen/ds_space_2"
                android:textColor="@color/ds_text_secondary"
                tools:text="#2" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/deleteProductButton"
                style="@style/Widget.InternalApps.Dashboard.IconButton"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                app:icon="@drawable/ic_more_vert"
                app:iconGravity="textStart"
                app:noBackground="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_product_thumb_placeholder">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="DL"
                    android:textColor="@color/ds_text_muted"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="2"
                    android:textColor="@color/ds_primary"
                    tools:text="DELL 97 WHR 9-CELL LI-ION PRIMARY BATTERY" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:textColor="@color/ds_text_muted"
                    tools:text="EST-KJ321 â€¢ Product" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit Price"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/unitPriceText"
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ds_text_primary"
                    tools:text="$377.21" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qty"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/quantityText"
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ds_text_primary"
                    tools:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Line Total"
                    android:textColor="@color/ds_text_muted" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/lineTotalText"
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/ds_text_primary"
                    tools:text="$0.00" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:background="@drawable/bg_quote_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_12"
            android:paddingTop="@dimen/ds_space_10"
            android:paddingEnd="@dimen/ds_space_12"
            android:paddingBottom="@dimen/ds_space_10">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@null"
                android:src="@drawable/ia_ic_filter_calendar"
                app:tint="@color/ds_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/deliveryScheduleSummaryText"
                    style="@style/Text.InternalApps.Body"
                    android:layout_width="match_parent"
                    android:textColor="@color/ds_primary"
                    tools:text="2 Schedules" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/deliveryScheduleSubtext"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:textColor="@color/ds_warning"
                    tools:text="1 units over-scheduled" />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to edit"
                android:textColor="@color/ds_text_muted" />

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginStart="@dimen/ds_space_4"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/ds_text_muted" />
        </LinearLayout>
    </LinearLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>



