<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_10"
        android:alpha="0.55"
        android:background="@drawable/bg_filter_field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/inventory_transactions_title"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_14ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/productNameText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_text_secondary"
                tools:text="#6 WALL BRACKET WHITE" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/transactionCountText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_muted"
                android:textSize="@dimen/_9ssp"
                tools:text="4 transactions" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/closeButton"
            style="@style/Widget.Fluent2.IconButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:contentDescription="@string/close"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:icon="@drawable/ia_ic_filter_close"
            app:noBackground="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_16"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/transactionsShimmerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_space_20"
            android:paddingEnd="@dimen/ds_space_20"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transactionsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_space_14"
            android:paddingEnd="@dimen/ds_space_14"
            android:paddingBottom="@dimen/ds_space_24"
            tools:listitem="@layout/item_inventory_transaction" />

        <LinearLayout
            android:id="@+id/transactionsEmptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_24"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:src="@drawable/ic_info_outline"
                app:tint="@color/ds_text_muted" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:text="@string/inventory_transactions_empty"
                android:textColor="@color/ds_text_secondary" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/transactionsErrorText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/ds_space_24"
            android:text="@string/inventory_transactions_error"
            android:textColor="@color/ds_text_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/transactionsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_20"
        android:paddingEnd="@dimen/ds_space_20"
        android:paddingBottom="@dimen/ds_space_16">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_info_outline"
            app:tint="@color/ds_text_muted" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:text="@string/inventory_transactions_latest_first"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>
</LinearLayout>
