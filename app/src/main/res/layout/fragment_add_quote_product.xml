<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/ia_start_gl"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/ia_end_gl"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/ia_top_gl"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/ia_bottom_gl"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppButtonView
        android:id="@+id/backButton"
        style="@style/Widget.InternalApps.Dashboard.IconButton"
        app:icon="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/screenTitle"
        style="@style/Text.InternalApps.Heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/add_quote_product_title"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toStartOf="@id/moreButton"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <com.axelliant.hris.ui.designsystem.components.AppButtonView
        android:id="@+id/moreButton"
        style="@style/Widget.InternalApps.Button.Text"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:text=""
        android:visibility="gone"
        app:icon="@drawable/ic_more_vert"
        app:iconGravity="textStart"
        app:noBackground="true"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/productsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_10"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ds_space_24">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.InternalApps.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                app:endIconDrawable="@drawable/ia_ic_filter_close"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ia_ic_search">

                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                    android:id="@+id/searchEditText"
                    style="@style/Widget.InternalApps.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_quote_product_search_hint"
                    android:imeOptions="actionSearch"
                    android:background="@drawable/bg_quote_search"
                    android:inputType="text"
                    android:paddingStart="@dimen/ds_space_8"
                    android:paddingEnd="@dimen/ds_space_12"
                    android:textColorHint="@color/ds_text_muted" />
            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/filterButton"
                style="@style/Widget.InternalApps.Button.Primary"
                android:layout_width="@dimen/_118sdp"
                android:layout_height="@dimen/_56sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ds_space_20"
                android:background="@drawable/bg_quote_save_draft_button"
                android:text="@string/filters"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_16ssp"
                app:backgroundTint="@null"
                app:cornerRadius="@dimen/ia_ds_radius_md"
                app:icon="@drawable/ia_ic_filter"
                app:iconGravity="textStart"
                android:visibility="gone"
                app:iconTint="@color/ds_text_primary" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ds_space_20"
                android:indeterminateTint="@color/ds_primary"
                android:visibility="gone" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/errorText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_20"
                android:gravity="center"
                android:textColor="@color/ds_error"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/productsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:orientation="vertical" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/emptyStateText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_32"
                android:gravity="center"
                android:text="@string/empty_state"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface"
        android:elevation="@dimen/_4sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_4"
        android:paddingBottom="@dimen/ds_space_8"
        app:layout_constraintBottom_toBottomOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline">

        <LinearLayout
            android:id="@+id/ly_totalValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/confirmButton"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/selectedCountText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/ds_text_primary" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/estimatedTotalText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ds_space_2"
                android:textColor="@color/ds_text_primary" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/confirmButton"
            style="@style/Widget.InternalApps.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_button_height"
            android:background="@drawable/bg_quote_create_button"
            android:enabled="false"
            android:text="@string/add_quote_confirm_selection"
            android:textColor="@color/ia_white"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/ia_ds_radius_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ly_totalValue"
            app:layout_constraintTop_toTopOf="@id/ly_totalValue"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>




