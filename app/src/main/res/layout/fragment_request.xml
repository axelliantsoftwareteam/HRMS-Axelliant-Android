<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_screen_bg"
    android:orientation="vertical">

    <com.axelliant.hris.ui.WsToolbar
        android:id="@+id/req_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:wsTitle="@string/req_title_leave" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/_16sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_24sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Form card: header band + fields -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/req_form_bg"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ws_grey"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/req_header_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingTop="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:paddingBottom="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ws_ic_schedule"
                            app:tint="@color/ws_primary" />

                        <TextView
                            android:id="@+id/req_tv_header"
                            style="@style/Ws.Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:textSize="@dimen/_15ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_14sdp">

                        <!-- ===================== Leave form ===================== -->
                        <LinearLayout
                            android:id="@+id/req_group_leave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                style="@style/Ws.Text.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:text="@string/req_label_leave_type"
                                android:textSize="@dimen/_13ssp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/req_til_leave_type"
                                style="@style/Widget.Ws.TextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@color/white"
                                app:endIconDrawable="@drawable/ws_ic_expand_more"
                                app:endIconMode="custom"
                                app:endIconTint="@color/black"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/req_et_leave_type"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:inputType="none"
                                    android:textAppearance="@style/Ws.Text.Input" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_start_date"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/req_til_start_date"
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:endIconDrawable="@drawable/ws_ic_calendar"
                                        app:endIconMode="custom"
                                        app:endIconTint="@color/black"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_start_date"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:hint="@string/req_placeholder_date"
                                            android:inputType="none"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_end_date"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/req_til_end_date"
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:endIconDrawable="@drawable/ws_ic_calendar"
                                        app:endIconMode="custom"
                                        app:endIconTint="@color/black"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_end_date"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:hint="@string/req_placeholder_date"
                                            android:inputType="none"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Optional half day (kept from the previous version, unobtrusive) -->
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/req_cb_half_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/req_half_day"
                                android:textSize="@dimen/_12ssp" />

                            <LinearLayout
                                android:id="@+id/req_col_half_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    style="@style/Ws.Text.Medium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_6sdp"
                                    android:layout_marginBottom="@dimen/_6sdp"
                                    android:text="@string/req_label_half_day_date"
                                    android:textSize="@dimen/_13ssp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/req_til_half_date"
                                    style="@style/Widget.Ws.TextInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:boxBackgroundColor="@color/white"
                                    app:endIconDrawable="@drawable/ws_ic_calendar"
                                    app:endIconMode="custom"
                                    app:endIconTint="@color/black"
                                    app:hintEnabled="false">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/req_et_half_date"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:cursorVisible="false"
                                        android:focusable="false"
                                        android:hint="@string/req_placeholder_date"
                                        android:inputType="none"
                                        android:textAppearance="@style/Ws.Text.Input" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_leave_count"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_leave_count"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:inputType="none"
                                            android:text="@string/req_zero"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_remaining"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_remaining"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:inputType="none"
                                            android:text="@string/req_zero"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/Ws.Text.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:text="@string/req_label_leave_reason"
                                android:textSize="@dimen/_13ssp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/req_til_leave_reason"
                                style="@style/Widget.Ws.TextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@color/white"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/req_et_leave_reason"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="top|start"
                                    android:inputType="textMultiLine|textCapSentences"
                                    android:maxLength="500"
                                    android:minLines="6"
                                    android:textAppearance="@style/Ws.Text.Input" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- =================== Attendance form =================== -->
                        <LinearLayout
                            android:id="@+id/req_group_attendance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                style="@style/Ws.Text.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:text="@string/req_label_attendance_type"
                                android:textSize="@dimen/_13ssp" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/req_toggle_type"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true" />

                            <TextView
                                android:id="@+id/req_err_type"
                                style="@style/Ws.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/req_err_attendance_type"
                                android:textColor="@color/ws_red"
                                android:textSize="@dimen/_10ssp"
                                android:visibility="gone" />

                            <TextView
                                style="@style/Ws.Text.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:text="@string/req_label_location"
                                android:textSize="@dimen/_13ssp" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/req_toggle_location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true" />

                            <TextView
                                android:id="@+id/req_err_location"
                                style="@style/Ws.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/req_err_location"
                                android:textColor="@color/ws_red"
                                android:textSize="@dimen/_10ssp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_date"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/req_til_date"
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:endIconDrawable="@drawable/ws_ic_calendar"
                                        app:endIconMode="custom"
                                        app:endIconTint="@color/black"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_date"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:hint="@string/req_placeholder_date"
                                            android:inputType="none"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Ws.Text.Medium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/_6sdp"
                                        android:text="@string/req_label_time"
                                        android:textSize="@dimen/_13ssp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/req_til_time"
                                        style="@style/Widget.Ws.TextInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:boxBackgroundColor="@color/white"
                                        app:endIconDrawable="@drawable/ws_ic_schedule"
                                        app:endIconMode="custom"
                                        app:endIconTint="@color/black"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/req_et_time"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:cursorVisible="false"
                                            android:focusable="false"
                                            android:hint="@string/req_placeholder_time"
                                            android:inputType="none"
                                            android:textAppearance="@style/Ws.Text.Input" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/Ws.Text.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:text="@string/req_label_reason"
                                android:textSize="@dimen/_13ssp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/req_til_reason"
                                style="@style/Widget.Ws.TextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@color/white"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/req_et_reason"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="top|start"
                                    android:inputType="textMultiLine|textCapSentences"
                                    android:maxLength="500"
                                    android:minLines="6"
                                    android:textAppearance="@style/Ws.Text.Input" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer: Apply (create) or Delete + Update (edit) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/req_btn_apply"
                style="@style/Widget.Ws.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:minHeight="@dimen/_50sdp"
                android:text="@string/req_apply" />

            <LinearLayout
                android:id="@+id/req_group_edit_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/req_btn_delete"
                    style="@style/Widget.Ws.Button.OutlineRed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/_50sdp"
                    android:text="@string/req_delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/req_btn_update"
                    style="@style/Widget.Ws.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/_50sdp"
                    android:text="@string/req_update" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
