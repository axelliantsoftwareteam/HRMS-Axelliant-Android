<?xml version="1.0" encoding="utf-8"?>
<!-- Status filter chip (iOS look): selected = primary fill / white text, unselected = white with a grey stroke. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/_8sdp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ly_work_home"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_32sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ws_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_6sdp">

            <TextView
                android:id="@+id/tv_work_from"
                style="@style/Ws.Text.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_6sdp"
                android:maxLines="1"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/tv_work_txt"
                style="@style/Ws.Text.Medium"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="@drawable/ws_circle_bg"
                android:backgroundTint="@color/ws_azure"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
