<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ia_ds_radius_md"
    app:cardElevation="@dimen/_2sdp"
    app:cardUseCompatPadding="false"
    app:strokeColor="#E8EEF5"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_12">

        <FrameLayout
            android:id="@+id/thumbnailFrame"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/bg_product_thumb_placeholder">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/thumbnailLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:textColor="@color/ds_text_muted"
                android:textSize="@dimen/_8ssp"
                tools:text="CS" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/productNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_9ssp"
                tools:text="Cisco Firepower 2100 Series" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/productPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ds_primary"
                android:textSize="@dimen/_9ssp"
                tools:text="$2,400.00" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/productMenuButton"
            style="@style/Widget.Fluent2.IconButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/ds_space_4"
            android:contentDescription="@string/add_quote_product_actions"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="textStart"
            app:noBackground="true" />
    </LinearLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>



