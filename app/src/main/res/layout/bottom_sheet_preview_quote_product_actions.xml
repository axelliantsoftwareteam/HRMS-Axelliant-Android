<?xml version="1.0" encoding="utf-8"?>
<!-- UI PROTOTYPE ONLY â€” product actions bottom sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/ds_space_16"
    tools:ignore="HardcodedText">

    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_10"
        android:background="@drawable/bg_filter_field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Product"
                android:textColor="@color/ds_text_muted" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/productTitleText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2"
                android:textColor="@color/ds_primary"
                tools:text="DELL 97 WHR 9-CELL LI-ION PRIMARY BATTERY" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/closeSheetButton"
            style="@style/Widget.Fluent2.IconButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:icon="@drawable/ia_ic_filter_close"
            app:iconGravity="textStart"
            app:noBackground="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_12"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:background="@drawable/bg_quote_save_draft_button"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unit Price"
                android:textColor="@color/ds_text_muted" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/unitPriceText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ds_text_primary"
                tools:text="$377.21" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/_1sdp"
            android:layout_height="match_parent"
            android:background="@color/ds_outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Line Total"
                android:textColor="@color/ds_text_muted" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/lineTotalText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ds_text_primary"
                tools:text="$0.00" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                android:id="@+id/basePriceInputLayout"
                style="@style/Widget.InternalApps.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Base Price *"
                app:endIconDrawable="@drawable/ia_ic_filter_close"
                app:endIconMode="clear_text"
                app:errorEnabled="true"
                app:errorIconDrawable="@null"
                tools:error="Enter a valid base price">

                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                    android:id="@+id/basePriceInput"
                    style="@style/Widget.InternalApps.InputEditText"
                    android:inputType="numberDecimal"
                    tools:text="0.00" />
            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_14"
                android:text="Qty"
                android:textColor="@color/ds_text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_input_height"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_quote_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_4"
                android:paddingEnd="@dimen/ds_space_4">

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/decreaseQtyButton"
                    style="@style/Widget.Fluent2.IconButton"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="-"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="18sp"
                    app:noBackground="true" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/quantityText"
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:textColor="@color/ds_text_primary"
                    tools:text="5" />

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/increaseQtyButton"
                    style="@style/Widget.Fluent2.IconButton"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="18sp"
                    app:noBackground="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delivery Schedule"
                    android:textColor="@color/ds_text_primary" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/scheduleCountText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ds_primary"
                    tools:text="2 schedules" />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/scheduleWarningText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:text="1 units over-scheduled"
                android:textColor="@color/ds_warning"
                android:visibility="gone"
                tools:visibility="visible" />

            <include layout="@layout/item_preview_delivery_schedule_row" />

            <include layout="@layout/item_preview_delivery_schedule_row" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/addDeliveryScheduleButton"
                style="@style/Widget.Fluent2.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_button_height"
                android:layout_marginTop="@dimen/ds_space_4"
                android:text="+ Add Delivery Schedule"
                android:textColor="@color/ds_primary"
                app:icon="@drawable/ia_ic_add"
                app:iconTint="@color/ds_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.axelliant.hris.ui.designsystem.components.AppButtonView
        android:id="@+id/applyProductActionsButton"
        style="@style/Widget.Fluent2.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_button_height"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_12"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:background="@drawable/bg_quote_create_button"
        android:text="Apply Changes"
        android:textColor="@color/ia_white"
        app:backgroundTint="@null"
        app:cornerRadius="@dimen/ds_radius_md" />
</LinearLayout>




