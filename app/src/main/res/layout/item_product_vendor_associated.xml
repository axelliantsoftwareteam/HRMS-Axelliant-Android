<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_6"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ia_ds_radius_md"
    app:cardElevation="@dimen/_2sdp"
    app:strokeColor="#E6EEF8"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_8sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_product_detail_info_icon">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_detail_building" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_6"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorName"
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="TD_SYNNEX" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorSku"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_secondary"
                    tools:text="SKU/Part NO: 85058, 97404-H34..." />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/vendorStatus"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="@dimen/_66sdp"
                android:layout_height="@dimen/_28sdp"
                android:background="@drawable/bg_status_success"
                android:gravity="center"
                android:textColor="@color/ds_success"
                tools:text="Active" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="@dimen/ds_space_6"
            android:background="@color/ds_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:text="@string/availability" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorAvailability"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="@dimen/_66sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:background="@drawable/bg_status_success"
                    android:gravity="center"
                    android:textColor="@color/ds_success"
                    tools:text="In Stock" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:background="@color/ds_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:text="@string/unit" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorUnit"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:fontFamily="@font/poppins_semibold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="9999" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:background="@color/ds_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:text="@string/cost_price" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorCostPrice"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:fontFamily="@font/poppins_semibold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="$204.17" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:background="@color/ds_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:text="@string/list_price" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/vendorListPrice"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:fontFamily="@font/poppins_semibold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_primary"
                    tools:text="$245.00" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>

