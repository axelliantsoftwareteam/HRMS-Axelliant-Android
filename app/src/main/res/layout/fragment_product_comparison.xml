<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    style="@style/Layout.Fluent2.Screen" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:actionIcon="@drawable/ic_retry"
        app:showActionButton="true"
        app:titleText="@string/product_compare_title_empty"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/compareScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/ds_space_24"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/ds_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppCardView
                    android:id="@+id/productOneCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/ds_surface"
                    app:cardCornerRadius="@dimen/ds_radius_md"
                    app:cardElevation="@dimen/ds_card_elevation"
                    app:strokeColor="@color/ds_outline"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:id="@+id/productOneContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_10">

                        <LinearLayout
                            android:id="@+id/productOneHeaderRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productOneBadge"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/product_compare_product_one"
                                android:textColor="@color/ds_primary"
                                android:textSize="@dimen/_7ssp" />

                            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                                android:id="@+id/productOneEditButton"
                                style="@style/Widget.Fluent2.IconButton"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:contentDescription="@string/product_compare_edit_product"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:icon="@drawable/ic_review_edit"
                                app:iconGravity="textStart"
                                app:noBackground="true"
                                app:iconSize="@dimen/ds_icon_button_icon_size" />

                            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                                android:id="@+id/productOneDeleteButton"
                                style="@style/Widget.Fluent2.IconButton"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:contentDescription="@string/product_compare_remove_product"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:icon="@drawable/ic_delete"
                                app:iconGravity="textStart"
                                app:noBackground="true"
                                app:iconSize="@dimen/ds_icon_button_icon_size" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/productOnePlaceholderIconFrame"
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:background="@drawable/bg_smart_quote_add_more_icon"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ia_ic_add"
                                app:tint="@color/ds_primary" />
                        </FrameLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productOneName"
                            style="@style/Text.InternalApps.Subheading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:textSize="@dimen/_8ssp"
                            tools:text="# OF CHANNEL 2.0/\n# OF SPEAKER 6" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productOneSku"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/ds_text_secondary"
                            tools:text="AXE-0741351" />

                        <Space
                            android:id="@+id/productOneSpacer"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productOnePrice"
                                style="@style/Text.InternalApps.Subheading"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="@dimen/_8ssp"
                                tools:text="$399.99" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productOneStatus"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingStart="@dimen/ds_space_6"
                                android:paddingTop="@dimen/ds_space_2"
                                android:paddingEnd="@dimen/ds_space_6"
                                android:paddingBottom="@dimen/ds_space_2"
                                android:textSize="@dimen/_7ssp"
                                tools:text="Out of Stock" />
                        </LinearLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productOneAction"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/product_compare_choose_with_ai"
                            android:textColor="@color/ds_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.axelliant.hris.ui.designsystem.components.AppCardView>

                <com.axelliant.hris.ui.designsystem.components.AppCardView
                    android:id="@+id/productTwoCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/ds_surface"
                    app:cardCornerRadius="@dimen/ds_radius_md"
                    app:cardElevation="@dimen/ds_card_elevation"
                    app:strokeColor="@color/ds_outline"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:id="@+id/productTwoContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_10">

                        <LinearLayout
                            android:id="@+id/productTwoHeaderRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productTwoBadge"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/product_compare_product_two"
                                android:textColor="@color/ds_primary"
                                android:textSize="@dimen/_7ssp" />

                            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                                android:id="@+id/productTwoEditButton"
                                style="@style/Widget.Fluent2.IconButton"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:contentDescription="@string/product_compare_edit_product"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:icon="@drawable/ic_review_edit"
                                app:iconGravity="textStart"
                                app:noBackground="true"
                                app:iconSize="@dimen/ds_icon_button_icon_size" />

                            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                                android:id="@+id/productTwoDeleteButton"
                                style="@style/Widget.Fluent2.IconButton"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:contentDescription="@string/product_compare_remove_product"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:icon="@drawable/ic_delete"
                                app:iconGravity="textStart"
                                app:noBackground="true"
                                app:iconSize="@dimen/ds_icon_button_icon_size" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/productTwoPlaceholderIconFrame"
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:background="@drawable/bg_smart_quote_add_more_icon"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ia_ic_add"
                                app:tint="@color/ds_primary" />
                        </FrameLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productTwoName"
                            style="@style/Text.InternalApps.Subheading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:textSize="@dimen/_8ssp"
                            tools:text="# OF CHANNEL 3.1.2/\n# OF SPEAKER 10" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productTwoSku"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/ds_text_secondary"
                            tools:text="AXE-0741349" />

                        <Space
                            android:id="@+id/productTwoSpacer"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productTwoPrice"
                                style="@style/Text.InternalApps.Subheading"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="@dimen/_8ssp"
                                tools:text="$399.99" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/productTwoStatus"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingStart="@dimen/ds_space_6"
                                android:paddingTop="@dimen/ds_space_2"
                                android:paddingEnd="@dimen/ds_space_6"
                                android:paddingBottom="@dimen/ds_space_2"
                                android:textSize="@dimen/_7ssp"
                                tools:text="In Stock (33)" />
                        </LinearLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/productTwoAction"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/product_compare_choose_with_ai"
                            android:textColor="@color/ds_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.axelliant.hris.ui.designsystem.components.AppCardView>
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/compareNowButton"
                style="@style/Widget.Fluent2.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_34sdp"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/ds_space_8"
                android:minHeight="@dimen/_34sdp"
                android:minWidth="0dp"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_12"
                android:text="@string/product_compare_now"
                android:textAllCaps="false"
                android:textSize="@dimen/_8ssp"
                android:visibility="gone"
                app:cornerRadius="@dimen/_12sdp"
                app:icon="@drawable/ic_compare_products"
                app:iconTint="@color/ia_white"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/ds_space_4"
                app:iconSize="@dimen/ds_button_inline_icon_size"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/comparisonLoadingContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_170sdp"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_ask_ai_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_20"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_sparkles" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/product_compare_analyzing"
                    android:textColor="@color/ds_text_primary" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:text="@string/product_compare_analyzing_details"
                    android:textColor="@color/ds_text_secondary" />

                <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_4sdp"
                    android:layout_marginStart="@dimen/ds_space_16"
                    android:layout_marginTop="@dimen/ds_space_14"
                    android:layout_marginEnd="@dimen/ds_space_16"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/ds_primary"
                    android:progressBackgroundTint="@color/ds_outline" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recommendationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:background="@drawable/bg_compare_recommendation"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/recommendationIcon"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ai_sparkles"
                        app:tint="@color/ds_success" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/recommendationTitleText"
                        style="@style/Text.InternalApps.Subheading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/product_compare_ai_recommendation"
                        android:textColor="@color/ds_success" />
                </LinearLayout>

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/recommendationText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingExtra="@dimen/ds_space_2"
                    android:text="@string/product_compare_recommendation_empty"
                    android:textColor="@color/ds_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginTop="@dimen/ds_space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/overviewTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/overviewTabText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/product_compare_tab_overview" />

                    <View
                        android:id="@+id/overviewTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_2sdp"
                        android:background="@drawable/bg_compare_tab_selected" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/priceStockTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/priceStockTabText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/product_compare_tab_price_stock" />

                    <View
                        android:id="@+id/priceStockTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_2sdp"
                        android:background="@drawable/bg_compare_tab_selected" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/moreDetailsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/moreDetailsTabText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/product_compare_tab_more_details" />

                    <View
                        android:id="@+id/moreDetailsTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_2sdp"
                        android:background="@drawable/bg_compare_tab_selected" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/comparisonTableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/_300sdp"
                    android:orientation="vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/comparisonActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/saveComparisonButton"
                    style="@style/Widget.Fluent2.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginEnd="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/product_compare_save"
                    android:textAllCaps="false"
                    android:textSize="@dimen/_7ssp" />

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/shareComparisonButton"
                    style="@style/Widget.Fluent2.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_marginEnd="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/product_compare_share"
                    android:textAllCaps="false"
