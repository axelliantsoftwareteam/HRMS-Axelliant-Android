<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F8F8"
        >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/start_guideline"
            style="@style/start_gl"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/end_guideline"
            style="@style/end_gl"
            android:orientation="vertical" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottom_guideline"
            style="@style/bottom_gl" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top_guideline"
            style="@style/top_gl" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@id/start_guideline"
            app:layout_constraintRight_toLeftOf="@id/end_guideline"
            app:layout_constraintTop_toBottomOf="@id/top_guideline">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_img"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_welcome"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                style="@style/TEXT_SEMI_BLACK_15"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="Arslan"
                android:textAlignment="textStart"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintBottom_toTopOf="@+id/tv_sub_title"
                app:layout_constraintLeft_toRightOf="@id/profile_img"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_sub_title"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="Software engineer"
                android:textAlignment="textStart"
                app:layout_constraintLeft_toRightOf="@id/profile_img"
                app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@color/divider"
            app:layout_constraintLeft_toRightOf="@id/start_guideline"
            app:layout_constraintRight_toLeftOf="@id/end_guideline"
            app:layout_constraintTop_toBottomOf="@+id/ly_info" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_attend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_bg"
            android:padding="@dimen/_10sdp"
            app:layout_constraintLeft_toRightOf="@id/start_guideline"
            app:layout_constraintRight_toLeftOf="@id/end_guideline"
            app:layout_constraintTop_toBottomOf="@id/divider">


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_date"
                style="@style/TEXT_MEDIUM_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@+id/line"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/tv_date_txt"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_date_txt"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="10 Sep, 2024"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@+id/line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date" />

            <View
                android:id="@+id/line"
                android:layout_width="@dimen/_2sdp"
                android:layout_height="@dimen/_2sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            </View>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_location"
                style="@style/TEXT_MEDIUM_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location"
                android:textAlignment="textStart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/line"
                app:layout_constraintBottom_toTopOf="@+id/tv_loc_txt"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_loc_txt"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Lahore, Punjab"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/line"
                app:layout_constraintTop_toBottomOf="@+id/tv_location" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_date_txt"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hour"
                    style="@style/TEXT_SEMI_BLACK_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:layout_margin="@dimen/_3sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/rounded_time_bg"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_min"
                    style="@style/TEXT_SEMI_BLACK_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:layout_margin="@dimen/_3sdp"
                    android:background="@drawable/rounded_time_bg"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_hour"
                    />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_sec"
                    style="@style/TEXT_SEMI_BLACK_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:layout_margin="@dimen/_3sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/rounded_time_bg"
                    android:textAlignment="textStart"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_min"
                    />
            </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_bg"
            android:padding="@dimen/_10sdp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toRightOf="@id/start_guideline"
            app:layout_constraintRight_toLeftOf="@id/end_guideline"
            app:layout_constraintTop_toBottomOf="@id/ly_attend">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_today_title"
                style="@style/TEXT_SEMI_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/today_attend"
                android:textAlignment="textStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_check_in"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/check_in"
                android:textAlignment="textStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_today_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_check_in_txt"
                style="@style/TEXT_MEDIUM_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="10:00 AM"
                android:textAlignment="textStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_check_in" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_check_out"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/check_out"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_today_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_check_out_txt"
                style="@style/TEXT_MEDIUM_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="20:00 PM"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_check_out" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_total_hour"
                style="@style/TEXT_MEDIUM_GREY_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/total_hours"
                android:textAlignment="textEnd"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_today_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_total_hour_txt"
                style="@style/TEXT_MEDIUM_BLACK_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="20:00 PM"
                android:textAlignment="textEnd"
                app:layout_constraintStart_toStartOf="@+id/tv_total_hour"
                app:layout_constraintTop_toBottomOf="@+id/tv_total_hour" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_weekly"
            style="@style/TEXT_SEMI_BLACK_15"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/weekly_attend"
            android:textAlignment="textStart"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@+id/ly_today"
            app:layout_constraintStart_toStartOf="@+id/start_guideline"
            />


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_view_all"
            style="@style/TEXT_MEDIUM_BLACK_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/view_all"
            android:textColor="@color/colorApp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@+id/ly_today"
            app:layout_constraintEnd_toEndOf="@+id/end_guideline"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_weekly"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@id/end_guideline"
            app:layout_constraintStart_toStartOf="@id/start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekly"
            app:layout_constraintBottom_toBottomOf="@id/bottom_guideline"
            tools:itemCount="2"
            tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/weekly_row" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>