<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/start_guideline"
            style="@style/start_gl"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/end_guideline"
            style="@style/end_gl"
            android:orientation="vertical" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottom_guideline"
            style="@style/bottom_gl" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top_guideline"
            style="@style/top_gl" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_title"
            style="@style/TEXT_SEMI_BLACK_15"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="@string/expense_claim"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintEnd_toEndOf="@id/end_guideline"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="@+id/iv_back" />

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_guideline" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"

            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/btn_apply"
            app:layout_constraintEnd_toEndOf="@+id/end_guideline"
            app:layout_constraintStart_toStartOf="@+id/start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/iv_back">



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_create_attend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_10sdp"

                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ly_attend_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_rectengle"
                    android:backgroundTint="#DFEBF5"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_attend_today"
                        style="@style/TEXT_REGULAR_WHITE_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:background="@drawable/circle_no_bg"
                        android:backgroundTint="@color/white"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_create_expense"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TEXT_MEDIUM_BLACK_10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:gravity="start|center"
                        android:text="@string/create_expense_claim"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_add_new"
                        app:layout_constraintStart_toEndOf="@+id/iv_attend_today"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_add_new"
                        style="@style/TEXT_SEMI_BLACK_10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_time_bg"
                        android:backgroundTint="@color/colorApp"
                        android:gravity="start|center"
                        android:padding="@dimen/_3sdp"
                        android:paddingEnd="@dimen/_5sdp"
                        android:drawableStart="@drawable/plus"
                        android:text="@string/add_expense"
                        android:textColor="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_leave_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ly_attend_header"
                    tools:itemCount="2"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/ly_add_new_expense"
                    />



                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_attach"
                    style="@style/TEXT_MEDIUM_BLACK_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="start|center"
                    android:text="@string/attachment"
                    app:layout_constraintTop_toBottomOf="@+id/rv_leave_count"
                    app:layout_constraintTop_toTopOf="@+id/tv_delete"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_delete"
                    app:layout_constraintStart_toStartOf="parent" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_delete"
                    style="@style/TEXT_SEMI_BLACK_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_time_bg"
                    android:backgroundTint="@color/colorApp"
                    android:gravity="start|center"
                    android:padding="@dimen/_3sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_5sdp"
                    android:drawableStart="@drawable/plus"
                    android:drawableTint="@color/white"
                    android:text="@string/add_attach"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@+id/tv_attach"
                    app:layout_constraintTop_toBottomOf="@+id/rv_leave_count"

                    />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attachment_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_delete"
                    tools:spanCount="3"
                    tools:itemCount="6"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/attachment_count_row"
                    />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_amount"
                    style="@style/TEXT_SEMI_BLACK_12"
                    android:layout_width="wrap_content"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_12sdp"
                    tools:text="1200.00"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintTop_toTopOf="@+id/tv_amount_title"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_amount_title"
                    app:layout_constraintStart_toEndOf="@+id/tv_amount_title"
                    />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_amount_title"
                    style="@style/TEXT_SEMI_BLACK_12"
                    android:layout_width="wrap_content"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_12sdp"
                    android:text="Grand total:"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintTop_toBottomOf="@+id/rv_attachment_count"
                    app:layout_constraintStart_toStartOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.core.widget.NestedScrollView>

            <com.axelliant.hrms.components.RoundedButton
                android:id="@+id/btn_apply"
                style="@style/ButtonTextStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:visibility="visible"
                app:buttonBg="@drawable/rounded_enabled"
                app:iconVisibility="false"
                app:layout_constraintBottom_toTopOf="@id/bottom_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:text="@string/create"
                app:textColor="@color/white" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>