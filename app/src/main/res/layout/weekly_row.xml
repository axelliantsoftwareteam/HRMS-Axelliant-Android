<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_weekly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/ly_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            android:gravity="center"
            android:background="@drawable/rounded_enabled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_date"
                style="@style/TEXT_SEMI_WHITE_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_day"
                style="@style/TEXT_SEMI_WHITE_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUE"
                android:textAlignment="textStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date" />

        </LinearLayout>
       <LinearLayout
           android:id="@+id/ly_check_in"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           app:layout_constraintLeft_toRightOf="@+id/ly_day"
           app:layout_constraintRight_toLeftOf="@+id/ly_check_out"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintBottom_toBottomOf="parent"
           >

           <com.google.android.material.textview.MaterialTextView
               android:id="@+id/tv_check_in"
               style="@style/TEXT_MEDIUM_GREY_10"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="@string/check_in"
               app:layout_constraintLeft_toRightOf="@+id/ly_day"
               app:layout_constraintTop_toTopOf="parent" />

           <com.google.android.material.textview.MaterialTextView
               android:id="@+id/tv_check_in_txt"
               style="@style/TEXT_MEDIUM_BLACK_10"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="20:00 PM"
               app:layout_constraintLeft_toRightOf="@+id/ly_day"
               app:layout_constraintTop_toBottomOf="@+id/tv_check_in" />
       </LinearLayout>


<LinearLayout
    android:id="@+id/ly_check_out"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="@dimen/_15sdp"
    app:layout_constraintStart_toEndOf="@+id/ly_check_in"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_check_out"
        style="@style/TEXT_MEDIUM_GREY_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/check_out"
        android:textAlignment="textEnd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_check_out_txt"
        style="@style/TEXT_MEDIUM_BLACK_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20:00 PM"
        android:textAlignment="textEnd"
        app:layout_constraintStart_toStartOf="@+id/tv_check_out"
        app:layout_constraintTop_toBottomOf="@+id/tv_check_out" />

</LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>