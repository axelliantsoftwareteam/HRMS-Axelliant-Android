<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout.Fluent2.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/subscriptionsContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toStartOf="@id/endGuideline"
        app:layout_constraintStart_toEndOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline">

    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showActionButton="false"
        app:showSearchButton="true"
        app:titleText="@string/subscription_plans" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/commerceTabs"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar"
        app:tabGravity="start"
        app:tabIconTint="@color/subscription_commerce_tab_text"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/ds_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/_2sdp"
        app:tabInlineLabel="true"
        app:tabMode="scrollable"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/ds_primary"
        app:tabTextAppearance="@style/CommerceTabTextAppearance"
        app:tabTextColor="@color/subscription_commerce_tab_text">

        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/ic_subscription_box"
            android:text="@string/drawer_subscriptions" />

        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/ic_dashboard_box"
            android:text="@string/subscription_plans" />

        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/ic_subscription_invoice"
            android:text="@string/subscription_invoices" />

        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/ic_subscription_renew"
            android:text="@string/subscription_reconciliation" />
    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/plansScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/commerceTabs">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_5sdp">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.InternalApps.InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:hint="@string/subscription_plans_search_hint"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:startIconDrawable="@drawable/ia_ic_search">

                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                    android:id="@+id/searchEditText"
                    style="@style/Widget.InternalApps.SubscriptionInputEditText"
                    android:hint="@string/subscription_plans_search_hint" />
            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filterTabsRecyclerView"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/ds_space_10"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toStartOf="@id/filterButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchInputLayout" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/filterButton"
                style="@style/Widget.Fluent2.Button.Icon"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/bg_subscription_filter_chip"
                android:text=""
                android:visibility="gone"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_subscription_filter"
                app:iconSize="@dimen/_16sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:noBackground="true" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/plansCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:fontFamily="@font/poppins_bold"
                android:textAlignment="textStart"
                android:textColor="@color/ds_text_muted"
                android:textSize="@dimen/text_size_15"
                tools:text="@string/subscription_plans_count"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@id/filterButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/filterTabsRecyclerView"
                />

            <LinearLayout
                android:id="@+id/shimmerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintTop_toBottomOf="@+id/plansCountText"

                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plansRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="visible"
                tools:itemCount="3"
                tools:listitem="@layout/item_subscription_plan_business"
                app:layout_constraintTop_toBottomOf="@+id/plansCountText"
                />

            <LinearLayout
                android:id="@+id/paginationShimmerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/plansCountText"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/subscription_plans_empty_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_14ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:text="@string/subscription_plans_empty_description"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_11ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/emptyRetryButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:fontFamily="sans-serif-medium"
            android:text="@string/purchase_orders_try_again"
            app:icon="@drawable/ic_retry"
            app:iconGravity="textStart"
            app:iconTint="@color/ds_on_primary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorStateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/subscription_plans_error_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_14ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/errorDescriptionText"
            style="@style/Text.InternalApps.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:text="@string/subscription_plans_error_description"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_11ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/errorRetryButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/retry"
            app:icon="@drawable/ic_retry"
            app:iconGravity="textStart"
            app:iconTint="@color/ds_on_primary" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/newPlanButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_subscription_new_button"
        android:clickable="true"
        android:elevation="@dimen/_6sdp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toStartOf="@id/endGuideline">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="@color/ds_on_primary"
            android:textSize="@dimen/_22ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/subscription_new_plan"
            android:textColor="@color/ds_on_primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
