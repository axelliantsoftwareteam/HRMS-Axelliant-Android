<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_14sdp"
    android:background="@drawable/bg_subscription_card"
    android:elevation="@dimen/_2sdp"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/subscriptionNumberText"
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUB-1048"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_12ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/statusBadge"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_subscription_status_active"
            android:gravity="center"
            android:text="@string/subscription_status_active"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:textColor="@color/subscription_active_text"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_account"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_9ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/accountNameText"
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp"
                android:maxLines="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_plan"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_9ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/planNameText"
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp"
                android:maxLines="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_price"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_9ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/priceText"
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/billingLabelText"
                style="@style/Text.InternalApps.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_next_billing"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/_9ssp" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/nextBillingDateText"
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/autoRenewText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_subscription_status_active"
            android:gravity="center"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:textColor="@color/subscription_active_text"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/ds_outline" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/viewDetailsText"
        style="@style/Text.Fluent2.Title.Primary.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/subscription_view_details"
        android:textColor="@color/ds_primary"
        android:textSize="@dimen/_10ssp" />
</LinearLayout>
