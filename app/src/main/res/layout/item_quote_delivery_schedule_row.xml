<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.InternalApps.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_10"
    app:cardBackgroundColor="@color/ds_surface_variant"
    app:cardElevation="0dp"
    app:strokeColor="@color/ds_outline"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/deliveryLabelText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ds_text_primary"
                tools:text="Delivery #1" />

            <com.axelliant.hris.ui.designsystem.components.AppButtonView
                android:id="@+id/deleteDeliveryButton"
                style="@style/Widget.InternalApps.Dashboard.IconButton"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:contentDescription="@string/add_quote_delete_delivery"
                android:minHeight="0dp"
                android:minWidth="0dp"
                app:icon="@drawable/ia_ic_filter_close"
                app:iconGravity="textStart"
                app:noBackground="true" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:text="@string/add_quote_shipping_address_label"
            android:textColor="@color/ds_text_muted" />

        <LinearLayout
            android:id="@+id/shippingAddressField"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/ds_space_4"
            android:background="@drawable/bg_quote_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_10"
            android:paddingEnd="@dimen/ds_space_8">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/shippingAddressText"
                style="@style/Text.InternalApps.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ds_text_primary"
                tools:text="Apple Valley, MN, USA, 55124" />

            <ImageView
                android:id="@+id/shippingAddressDropdownIcon"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ia_ic_filter_down"
                app:tint="@color/ds_text_muted" />
        </LinearLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/defaultAddressHintText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="@string/add_quote_default_shipping_address"
            android:textColor="@color/ds_primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                android:id="@+id/deliveryQtyInputLayout"
                style="@style/Widget.InternalApps.InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:layout_weight="1"
                android:hint="@string/add_quote_qty"
                app:endIconDrawable="@drawable/ia_ic_filter_close"
                app:endIconMode="clear_text">

                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                    android:id="@+id/deliveryQtyInput"
                    style="@style/Widget.InternalApps.InputEditText"
                    android:gravity="center"
                    android:inputType="number"
                    tools:text="5" />
            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                android:id="@+id/deliveryDateInputLayout"
                style="@style/Widget.InternalApps.InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:hint="@string/add_quote_est_delivery_date"
                app:endIconDrawable="@drawable/ia_ic_filter_calendar"
                app:endIconMode="custom">

                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                    android:id="@+id/deliveryDateInput"
                    style="@style/Widget.InternalApps.InputEditText"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    tools:text="06/17/2026" />
            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.InternalApps.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_quote_delivery_total"
                android:textColor="@color/ds_text_secondary" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/deliveryLineTotalText"
                style="@style/Text.InternalApps.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ds_text_primary"
                tools:text="$0.00" />
        </LinearLayout>
    </LinearLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>



