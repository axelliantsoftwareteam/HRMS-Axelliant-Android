<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ws.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_9sdp">

        <TextView
            android:id="@+id/lv_quota_name"
            style="@style/Ws.Text.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ws_grey"
            android:textSize="@dimen/_10ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lv_quota_remaining"
                style="@style/Ws.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_15ssp" />

            <TextView
                android:id="@+id/lv_quota_total"
                style="@style/Ws.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:textColor="@color/ws_grey"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/lv_quota_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:max="1000"
            app:trackColor="@color/lv_progress_track"
            app:trackCornerRadius="@dimen/_2sdp"
            app:trackThickness="@dimen/_4sdp" />

        <TextView
            style="@style/Ws.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/lv_quota_caption"
            android:textColor="@color/ws_grey"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
