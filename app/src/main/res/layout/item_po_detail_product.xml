<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.InternalApps.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_8"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="@color/purchase_order_card_stroke"
    app:strokeWidth="@dimen/_1sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ds_space_12">

        <FrameLayout
            android:id="@+id/productThumbnail"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/bg_po_product_thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_detail_box"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/productNameText"
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="2"
            android:textColor="@color/ds_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/productThumbnail"
            app:layout_constraintTop_toTopOf="@id/productThumbnail"
            tools:text="Dell Latitude 5440 - 14&quot; Laptop" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/partNumberText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:layout_marginTop="@dimen/ds_space_4"
            android:textColor="@color/ds_text_muted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/productThumbnail"
            app:layout_constraintTop_toBottomOf="@id/productNameText"
            tools:text="Part No: DELL-LAT-5440" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/qtyText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:layout_marginTop="@dimen/ds_space_6"
            android:textColor="@color/ds_text_muted"
            app:layout_constraintStart_toEndOf="@id/productThumbnail"
            app:layout_constraintTop_toBottomOf="@id/partNumberText"
            tools:text="QTY: 1" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/unitPriceText"
            style="@style/Text.InternalApps.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_10"
            android:textColor="@color/ds_text_muted"
            app:layout_constraintBaseline_toBaselineOf="@id/qtyText"
            app:layout_constraintEnd_toStartOf="@id/lineTotalValue"
            app:layout_constraintStart_toEndOf="@id/qtyText"
            tools:text="$89.99 / unit" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/lineTotalValue"
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/ds_primary"
            app:layout_constraintBaseline_toBaselineOf="@id/qtyText"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="$89.99" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>

