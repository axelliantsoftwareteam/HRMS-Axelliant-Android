<?xml version="1.0" encoding="utf-8"?>
<!-- UI PROTOTYPE ONLY — open in Layout Editor: list + bottom sheet overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    tools:ignore="HardcodedText">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.InternalApps.Subheading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_quote_products_information"
                    android:textColor="@color/ds_text_primary" />

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    style="@style/Widget.Fluent2.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ds_button_height"
                    android:background="@drawable/bg_quote_create_button"
                    android:text="@string/add_quote_add_product"
                    android:textColor="@color/ia_white"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/ds_radius_md" />
            </LinearLayout>

            <include layout="@layout/item_preview_quote_product_display" />

            <include layout="@layout/item_preview_quote_product_display" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:background="#000000" />

    <include
        layout="@layout/bottom_sheet_preview_quote_product_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>


