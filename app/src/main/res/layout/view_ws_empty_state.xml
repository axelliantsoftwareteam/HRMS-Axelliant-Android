<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Ws.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_11sdp">

            <ImageView
                android:id="@+id/ws_empty_icon"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ws_ic_calendar"
                app:tint="@color/ws_grey" />

            <TextView
                android:id="@+id/ws_empty_title"
                style="@style/Ws.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center" />

            <TextView
                android:id="@+id/ws_empty_message"
                style="@style/Ws.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
