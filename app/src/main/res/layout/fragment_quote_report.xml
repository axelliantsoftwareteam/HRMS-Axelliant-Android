<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout.Fluent2.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline"
        app:showBackButton="true"
        app:showSearchButton="false"
        app:titleText="@string/quote_report_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_10"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/ds_space_16"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/stickyTotalBar"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.Fluent2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_10"
                app:cardBackgroundColor="@color/ds_primary"
                app:cardElevation="@dimen/ds_card_elevation"
                app:strokeColor="@color/ds_primary"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <ImageView
                        android:id="@+id/companyLogo"
                        android:layout_width="@dimen/login_logo_width"
                        android:layout_height="@dimen/login_logo_height"
                        android:adjustViewBounds="true"
                        android:background="@drawable/bg_quote_report_logo_plate"
                        android:contentDescription="@string/app_name"
                        android:padding="@dimen/ds_space_6"
                        android:scaleType="fitStart"
                        android:src="@drawable/ic_applogo" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/companyAddressText"
                        style="@style/Text.Fluent2.Caption.Inverse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        tools:text="21250 Hawthorne Blvd. Suite 500, Torrance, CA 90503" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/companyPhoneText"
                        style="@style/Text.Fluent2.Caption.Inverse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        tools:text="+1-424-535-1100" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_neutral_white" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/quoteNumberText"
                        style="@style/Text.Fluent2.Title.Inverse.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Q-00000024" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/createdDateText"
                        style="@style/Text.Fluent2.Body.Inverse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        tools:text="Aug 31, 2026, 2:52 PM" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/customerTitleText"
                        style="@style/Text.Fluent2.Subheading.Inverse.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        tools:text="Testing Account CUS-00000042" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:background="@drawable/bg_quote_report_logo_plate"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_10">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.Fluent2.Caption.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quote_report_grand_total" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/summaryGrandTotalText"
                            style="@style/Text.Fluent2.Title.Primary.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="$2420.00" />
                    </LinearLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.Fluent2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_10"
                app:cardElevation="@dimen/ds_card_elevation"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_report_quote_information" />

                    <LinearLayout
                        android:id="@+id/quoteInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="vertical" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/quote_report_contact_information" />

                    <LinearLayout
                        android:id="@+id/contactInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.Fluent2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_10"
                app:cardElevation="@dimen/ds_card_elevation"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_report_addresses" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Caption.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/quote_report_billing_address" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/billingAddressText"
                        style="@style/Text.Fluent2.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        tools:text="Testing Account, east" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Caption.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/quote_report_shipping_address" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/shippingAddressText"
                        style="@style/Text.Fluent2.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        tools:text="Testing Account, west" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_report_hardware_details" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/productsCountText"
                        style="@style/Text.Fluent2.Caption.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="3 products" />
                </LinearLayout>

                <com.axelliant.hris.ui.designsystem.components.AppButtonView
                    android:id="@+id/productsToggleButton"
                    style="@style/Widget.Fluent2.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:minHeight="0dp"
                    android:text="@string/quote_report_show_all_products"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lineItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/emptyLineItemsText"
                style="@style/Text.Fluent2.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/ds_space_16"
                android:text="@string/quote_report_no_line_items"
                android:visibility="gone" />

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.Fluent2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:layout_marginBottom="@dimen/ds_space_10"
                app:cardElevation="@dimen/ds_card_elevation"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_report_totals" />

                    <LinearLayout
                        android:id="@+id/totalsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:layout_marginBottom="@dimen/ds_space_10"
                        android:background="@color/ds_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.Fluent2.Subheading.Primary.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quote_report_grand_total" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/grandTotalValueText"
                            style="@style/Text.Fluent2.Subheading.Primary.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            tools:text="$2420.00" />
                    </LinearLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.Fluent2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_10"
                app:cardElevation="@dimen/ds_card_elevation"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_report_customer_acceptance" />

                    <LinearLayout
                        android:id="@+id/acceptanceContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/footerText"
                style="@style/Text.Fluent2.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/ds_space_10"
                tools:text="Axelliant | Where Passion Drives Innovation" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.axelliant.hris.ui.designsystem.components.AppCardView
        android:id="@+id/stickyTotalBar"
        style="@style/Widget.Fluent2.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ds_primary_container"
        app:cardElevation="@dimen/ds_card_elevation"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:strokeColor="@color/ds_primary"
        app:strokeWidth="@dimen/_1sdp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_12"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_space_12"
            android:paddingBottom="@dimen/ds_space_8">

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.Fluent2.Caption.Primary.Strong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quote_report_grand_total" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                android:id="@+id/stickyGrandTotalText"
                style="@style/Text.Fluent2.Subheading.Primary.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="$2420.00" />
        </LinearLayout>
    </com.axelliant.hris.ui.designsystem.components.AppCardView>

    <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
        android:id="@+id/loadingProgress"
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_42sdp"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar" />

    <LinearLayout
        android:id="@+id/errorStateGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:id="@+id/errorStateText"
            style="@style/Text.Fluent2.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/quote_report_error" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/retryButton"
            style="@style/Widget.Fluent2.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ds_button_height"
            android:layout_marginTop="@dimen/ds_space_12"
            android:text="@string/retry" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
