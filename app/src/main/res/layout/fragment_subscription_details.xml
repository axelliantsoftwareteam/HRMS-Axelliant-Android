<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout.Fluent2.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    tools:context=".features.subscriptions.presentation.SubscriptionDetailsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppTopBarView
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintEnd_toStartOf="@id/moreButton"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline"
        app:showBackButton="true"
        app:showSearchButton="false"
        app:titleText="@string/subscription_details_title" />

    <com.axelliant.hris.ui.designsystem.components.AppButtonView
        android:id="@+id/moreButton"
        style="@style/Widget.Fluent2.Button.Text"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:background="@android:color/transparent"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:text=""
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_more_vert"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="@id/appTopBar"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintTop_toTopOf="@id/appTopBar"
        app:noBackground="true" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/ds_space_16"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:background="@drawable/bg_subscription_card"
                android:elevation="@dimen/_2sdp"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/subscriptionNumberText"
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/text_size_12"
                        tools:text="SUB-1048" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/statusBadge"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_26sdp"
                        android:background="@drawable/bg_subscription_status_active"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:text="@string/subscription_status_active"
                        android:textColor="@color/subscription_active_text"
                        android:textSize="@dimen/text_size_10" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_10"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_account"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="@dimen/_9ssp" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/accountNameText"
                            style="@style/Text.Fluent2.Title.Primary.Strong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:maxLines="2"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="@dimen/text_size_10"
                            tools:text="Contoso Ltd" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_plan"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="@dimen/_9ssp" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/planNameText"
                            style="@style/Text.Fluent2.Title.Primary.Strong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:maxLines="2"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="@dimen/text_size_10"
                            tools:text="Business Monthly" />
                    </LinearLayout>
                </LinearLayout>

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/priceText"
                    style="@style/Text.Fluent2.Title.Primary.Strong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_14"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="@dimen/text_size_18"
                    tools:text="USD 32.70" />

                <LinearLayout
                    android:id="@+id/viewAccountAction"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginTop="@dimen/ds_space_10"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/ds_text_primary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:text="@string/subscription_view_account"
                        android:textColor="@color/ds_primary"
                        android:textSize="@dimen/text_size_10" />
                </LinearLayout>
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:text="@string/subscription_lifecycle"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/text_size_12" />

            <LinearLayout
                android:id="@+id/lifecycleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_subscription_card"
                android:elevation="@dimen/_2sdp"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:background="@drawable/bg_subscription_detail_step_active"
                        android:gravity="center"
                        android:text="@string/subscription_step_done"
                        android:textColor="@color/ds_on_primary"
                        android:textSize="@dimen/text_size_12" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_weight="1"
                        android:background="@color/ds_primary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:background="@drawable/bg_subscription_detail_step_active"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/ds_on_primary"
                        android:textSize="@dimen/text_size_10" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_weight="1"
                        android:background="@color/ds_outline_strong" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:background="@drawable/bg_subscription_detail_step_inactive"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/text_size_10" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/lifecycleStarted"
                        layout="@layout/layout_subscription_detail_lifecycle_started" />

                    <include
                        android:id="@+id/lifecycleNextBilling"
                        layout="@layout/layout_subscription_detail_lifecycle_next" />

                    <include
                        android:id="@+id/lifecycleAutoRenew"
                        layout="@layout/layout_subscription_detail_lifecycle_renew" />
                </LinearLayout>
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:text="@string/subscription_commercial_terms"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/text_size_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_subscription_card"
                android:elevation="@dimen/_2sdp"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/termsUnitPrice"
                        layout="@layout/layout_subscription_detail_terms_unit_price" />

                    <include
                        android:id="@+id/termsQuantity"
                        layout="@layout/layout_subscription_detail_terms_quantity" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_10"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/termsDiscount"
                        layout="@layout/layout_subscription_detail_terms_discount" />

                    <include
                        android:id="@+id/termsTax"
                        layout="@layout/layout_subscription_detail_terms_tax" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:background="@color/ds_outline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subscription_monthly_total"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_10" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/monthlyTotalValue"
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_12"
                        tools:text="USD 32.70" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    style="@style/Text.Fluent2.Title.Primary.Strong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subscription_items"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="@dimen/text_size_12" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/itemCountText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="@dimen/text_size_10"
                    tools:text="1 item" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/addItemButton"
                    style="@style/Text.Fluent2.Title.Primary.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/ds_space_12"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/subscription_add_item_with_plus"
                    android:textColor="@color/ds_primary"
                    android:textSize="@dimen/text_size_10" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_subscription_card"
                android:clickable="true"
                android:elevation="@dimen/_2sdp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_10">

                <FrameLayout
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_42sdp"
                    android:background="@drawable/bg_subscription_detail_icon_tile">

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_subscription_box"
                        app:tint="@color/ds_text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_10"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/itemTitleText"
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_10"
                        tools:text="Cloud service license" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/itemSubtitleText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/_9ssp"
                        tools:text="Base plan" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/_56sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_quantity_label"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/_9ssp" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/itemQuantityValue"
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_10"
                        tools:text="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/_72sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_unit_price_label"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/_9ssp" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/itemUnitPriceValue"
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_10"
                        tools:text="USD 20.00" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ds_text_primary" />
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.Fluent2.Title.Primary.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:text="@string/subscription_billing"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/text_size_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_subscription_card"
                android:elevation="@dimen/_2sdp"
                android:orientation="vertical"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_12">

                <include
                    android:id="@+id/billingFrequency"
                    layout="@layout/layout_subscription_detail_billing_frequency" />

                <include
                    android:id="@+id/billingCurrency"
                    layout="@layout/layout_subscription_detail_billing_currency" />

                <include
                    android:id="@+id/billingInvoice"
                    layout="@layout/layout_subscription_detail_billing_invoice" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/additionalDetailsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:background="@drawable/bg_subscription_card"
                android:clickable="true"
                android:elevation="@dimen/_2sdp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Title.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_additional_details"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/text_size_12" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:text="@string/subscription_notes_external_reference"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/text_size_10" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ds_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface"
        android:orientation="horizontal"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingBottom="@dimen/ds_space_8"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline">

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/editSubscriptionButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_button_height"
            android:layout_marginEnd="@dimen/ds_space_8"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/subscription_edit_subscription"
            android:textAllCaps="false"
            android:textColor="@color/ds_on_primary"
            android:textSize="@dimen/text_size_10"
            app:icon="@drawable/ic_quote_action_edit"
            app:iconSize="@dimen/ds_button_inline_icon_size"
            app:iconTint="@color/ds_on_primary" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/viewInvoicesButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_sale_order_outlined_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/subscription_view_invoices"
            android:textAllCaps="false"
            android:textColor="@color/ds_primary"
            android:textSize="@dimen/text_size_10"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_subscription_invoice"
            app:iconSize="@dimen/ds_button_inline_icon_size"
            app:iconTint="@color/ds_primary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
