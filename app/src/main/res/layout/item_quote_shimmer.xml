<?xml version="1.0" encoding="utf-8"?>
<com.axelliant.hris.ui.designsystem.components.AppCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_8"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ia_ds_radius_md"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="#EEF3F8"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_78sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_8"
        android:paddingBottom="@dimen/ds_space_8">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="@dimen/_82sdp"
                android:layout_height="@dimen/_9sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="@dimen/_116sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_shimmer_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/_88sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_8sdp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="@dimen/ds_space_72"
                android:layout_height="@dimen/_22sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_shimmer_placeholder" />
        </LinearLayout>
    </LinearLayout>
</com.axelliant.hris.ui.designsystem.components.AppCardView>

