<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_10"
        android:alpha="0.55"
        android:background="@drawable/bg_filter_field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/inventory_adjust_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/_14ssp" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/closeButton"
            style="@style/Widget.Fluent2.IconButton"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:contentDescription="@string/close"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:icon="@drawable/ia_ic_filter_close"
            app:noBackground="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_12"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_space_14"
        android:paddingEnd="@dimen/ds_space_14"
        android:paddingBottom="@dimen/ds_space_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.InternalApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.Fluent2.Subheading.Primary.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/inventory_adjust_product_details_title" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_quote_status_submitted"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/ds_space_10"
                            android:paddingTop="@dimen/ds_space_4"
                            android:paddingEnd="@dimen/ds_space_10"
                            android:paddingBottom="@dimen/ds_space_4">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/inventory_adjust_current_on_hand"
                                android:textColor="@color/quotes_status_submitted_text" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/currentOnHandText"
                                style="@style/Text.InternalApps.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="@color/quotes_status_submitted_text"
                                tools:text="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/inventory_adjust_product_details_hint"
                        android:textColor="@color/ds_text_secondary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/inventory_adjust_product_label"
                        android:textColor="@color/ds_text_muted" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/productText"
                        style="@style/Text.InternalApps.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="3"
                        android:textColor="@color/ds_text_primary"
                        tools:text="#6 WALL BRACKET WHITE" />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                style="@style/Widget.InternalApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.Fluent2.Subheading.Primary.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/inventory_adjust_details_title" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/inventory_adjust_details_hint"
                        android:textColor="@color/ds_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/inventory_adjust_reason_required"
                                android:textColor="@color/ds_text_primary" />

                            <include
                                android:id="@+id/reasonFieldInclude"
                                layout="@layout/layout_warehouse_inventory_select_field" />

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/reasonErrorText"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_4"
                                android:text="@string/inventory_adjust_reason_error"
                                android:textColor="@color/ds_error"
                                android:visibility="gone" />
                        </LinearLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:text="@string/inventory_adjust_quantity_delta_required"
                            android:textColor="@color/ds_text_primary" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                            android:id="@+id/quantityDeltaInputLayout"
                            style="@style/Widget.InternalApps.InputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            android:hint="@string/inventory_adjust_quantity_delta_hint"
                            app:endIconMode="clear_text">

                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                android:id="@+id/quantityDeltaInput"
                                style="@style/Widget.InternalApps.InputEditText"
                                android:digits="-0123456789"
                                android:inputType="numberSigned"
                                android:maxLines="1" />
                        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>
                    </LinearLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:id="@+id/notesInputLayout"
                        style="@style/Widget.InternalApps.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:hint="@string/inventory_adjust_notes_required"
                        app:endIconMode="clear_text">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/notesInput"
                            style="@style/Widget.InternalApps.InputEditText"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="2"
                            android:singleLine="false" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:id="@+id/serialSection"
                style="@style/Widget.InternalApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:visibility="gone"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/ds_outline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_14">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/serialSectionTitle"
                            style="@style/Text.Fluent2.Subheading.Primary.Strong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/inventory_adjust_serial_numbers_title" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/serialCountBadge"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:background="@drawable/bg_quote_status_draft"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingStart="@dimen/ds_space_10"
                            android:paddingTop="@dimen/ds_space_4"
                            android:paddingEnd="@dimen/ds_space_10"
                            android:paddingBottom="@dimen/ds_space_4"
                            android:textColor="@color/quotes_status_draft_text"
                            android:textSize="@dimen/_8ssp"
                            tools:text="0 of 2 serials entered" />
                    </LinearLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/inventory_adjust_serial_numbers_hint"
                        android:textColor="@color/ds_text_secondary" />

                    <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                        android:id="@+id/serialNumbersInputLayout"
                        style="@style/Widget.InternalApps.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:hint="@string/inventory_adjust_serial_numbers_required"
                        app:endIconMode="clear_text">

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                            android:id="@+id/serialNumbersInput"
                            style="@style/Widget.InternalApps.InputEditText"
                            android:gravity="top|start"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:minLines="2"
                            android:singleLine="false" />
                    </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                    <com.axelliant.hris.ui.designsystem.components.AppTextView
                        android:id="@+id/serialHelpText"
                        style="@style/Text.InternalApps.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:textColor="@color/ds_text_secondary"
                        tools:text="Exact count of 2 unique serials required." />
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_70sdp"
        android:background="@drawable/bg_filter_footer_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16">

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/cancelButton"
            style="@style/Widget.Fluent2.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_button_height"
            android:layout_marginEnd="@dimen/ds_space_8"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.axelliant.hris.ui.designsystem.components.AppButtonView
            android:id="@+id/saveButton"
            style="@style/Widget.Fluent2.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_button_height"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="1"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
