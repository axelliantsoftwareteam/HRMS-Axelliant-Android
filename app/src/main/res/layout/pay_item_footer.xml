<?xml version="1.0" encoding="utf-8"?>
<!-- List footer shared by the paged lists: a small spinner while loading, or an end-of-list note. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_5sdp">

    <ProgressBar
        android:id="@+id/pay_footer_progress"
        android:layout_width="@dimen/_19sdp"
        android:layout_height="@dimen/_19sdp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/ws_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pay_footer_text"
        style="@style/Ws.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/_9ssp"
        android:visibility="gone" />
</FrameLayout>
