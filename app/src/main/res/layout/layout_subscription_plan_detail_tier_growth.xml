<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_subscription_detail_billing_divider"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/ds_space_8"
    android:paddingHorizontal="@dimen/ds_space_12">

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:background="@drawable/bg_subscription_plan_detail_number"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/ds_primary"
        android:textSize="@dimen/text_size_10" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.Fluent2.Title.Primary.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_tier_growth"
            android:textColor="@color/ds_text_primary"
            android:textSize="@dimen/text_size_10" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:text="@string/subscription_tier_growth_units"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/growthPriceText"
        style="@style/Text.Fluent2.Title.Primary.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ds_text_primary"
        android:textSize="@dimen/text_size_12" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_4"
        android:text="@string/subscription_each"
        android:textColor="@color/ds_text_secondary"
        android:textSize="@dimen/_9ssp" />

    <ImageView
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginStart="@dimen/ds_space_10"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ds_text_primary" />
</LinearLayout>
