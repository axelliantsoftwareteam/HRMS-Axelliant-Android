<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
    style="@style/Layout.Fluent2.Screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_neutral_white">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/start_guideline"
            style="@style/Guideline.Fluent2.Start"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/end_guideline"
            style="@style/Guideline.Fluent2.End"
            android:orientation="vertical" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottom_guideline"
            style="@style/Guideline.Fluent2.Bottom" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top_guideline"
            style="@style/Guideline.Fluent2.Top"
            app:layout_constraintGuide_begin="22dp" />

        <com.axelliant.hris.ui.designsystem.components.AppTopBarView
            android:id="@+id/appTopBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            app:centerTitle="true"
            app:showBackButton="true"
            app:showSearchButton="false"
            app:titleText="@string/document_request"
            app:layout_constraintEnd_toEndOf="@id/end_guideline"
            app:layout_constraintStart_toStartOf="@id/start_guideline"
            app:layout_constraintTop_toBottomOf="@id/top_guideline" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_attend_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_rectengle"
            android:backgroundTint="#DFEBF5"
            android:gravity="center"
            android:layout_marginTop="@dimen/_5sdp"
            android:padding="@dimen/_8sdp"
            app:layout_constraintEnd_toStartOf="@+id/end_guideline"
            app:layout_constraintStart_toEndOf="@+id/start_guideline"
            app:layout_constraintTop_toBottomOf="@id/appTopBar"
            >

            <ImageView
                android:id="@+id/iv_attend_today"
                style="@style/Text.Fluent2.Caption.Inverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:background="@drawable/circle_no_bg"
                android:backgroundTint="@color/ds_neutral_white"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_create_expense"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <com.axelliant.hris.ui.designsystem.components.AppTextView
                style="@style/Text.Fluent2.Caption.Primary.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_5sdp"
                android:gravity="start|center"
                android:text="@string/create_document_req"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_attend_today"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                style="@style/Text.Fluent2.Caption.Inverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="@drawable/circle_no_bg"
                android:backgroundTint="@color/ds_neutral_white"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"
                android:src="@drawable/iv_attach_file"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />



        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toStartOf="@+id/end_guideline"
            app:layout_constraintStart_toEndOf="@+id/start_guideline"
            app:layout_constraintTop_toBottomOf="@id/ly_attend_header"
            app:layout_constraintBottom_toTopOf="@+id/spacer"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_exp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/rounded_leave_filter"
                android:padding="@dimen/_5sdp">

                    <LinearLayout
                        android:id="@+id/ll_date"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:weightSum="1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/tv_attend_type"
                            style="@style/Text.Fluent2.Caption.Primary.Strong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="@string/employe_id"
                            android:textAlignment="textStart"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ly_attend_header" />

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/ll_dd"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_35sdp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/ll_date"
                        app:layout_constraintTop_toBottomOf="@+id/ll_date">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/ly_attend_type"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35sdp"
                            android:background="@drawable/rounded_leave_filter"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/tv_employee_Id"
                                style="@style/Text.Fluent2.Caption.Primary.Strong"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:hint="@string/date"
                                tools:text="asa"
                                android:paddingStart="@dimen/_5sdp"
                                android:textAlignment="textStart"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ly_amount"
                        android:layout_width="0dp"
                        app:layout_constraintTop_toBottomOf="@+id/ll_dd"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight=".5"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/tv_date"
                                style="@style/Text.Fluent2.Caption.Primary.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/due_date"
                                android:textAlignment="textStart" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/ly_date"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:background="@drawable/rounded_leave_filter"
                                android:orientation="vertical">


                                <com.axelliant.hris.ui.designsystem.components.AppTextView
                                    android:id="@+id/tv_date_txt"
                                    style="@style/Text.Fluent2.Caption.Primary.Strong"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:hint="@string/date"
                                    tools:text="asa"
                                    android:paddingStart="@dimen/_5sdp"
                                    android:textAlignment="textStart"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight=".5"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/tv_time"
                                style="@style/Text.Fluent2.Caption.Primary.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:text="@string/amount"
                                android:textAlignment="textStart" />


                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                                android:id="@+id/til_amount"
                                style="@style/Widget.Fluent2.InputLayout"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"                                android:layout_marginStart="@dimen/_5sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                    android:id="@+id/et_amount"
                                    style="@style/Text.Fluent2.Caption.Primary.Strong"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/amount"
                                    android:layout_gravity="center_vertical"
                                    android:inputType="numberDecimal"
                                    tools:text="asdsa"
                                    android:textColorHint="@color/ds_text_muted"
                                    />

                            </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ly_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/_10sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ly_amount">


                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/tv_attend_reason_header"
                            style="@style/Text.Fluent2.Caption.Primary.Strong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center"
                            android:text="@string/description" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                            android:id="@+id/til_attendance_reason"
                            style="@style/Widget.Fluent2.InputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"

                            android:gravity="start|top"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_attend_reason_header"
                            app:layout_constraintTop_toBottomOf="@+id/tv_attend_reason_header">

                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                android:id="@+id/et_attendance_reason"
                                style="@style/Text.Fluent2.Caption.Primary.Strong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start|top"
                                android:hint="@string/write_descrpt"
                                android:inputType="textMultiLine"
                                android:maxLines="3"
                                android:minLines="2"
                                android:singleLine="false"
                                android:textColorHint="@color/ds_text_muted"
                                tools:text="" />

                        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>


                    </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            app:layout_constraintTop_toBottomOf="@+id/nested"
            android:id="@+id/spacer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/btn_apply"

            />



<!--        <com.google.android.material.floatingactionbutton.FloatingActionButton-->
<!--            android:id="@+id/tv_add_new"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            app:layout_constraintEnd_toEndOf="@id/end_guideline"-->
<!--            app:layout_constraintBottom_toTopOf="@+id/btn_apply"-->
