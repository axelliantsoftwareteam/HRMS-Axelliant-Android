<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    style="@style/Layout.Fluent2.Screen" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smart_quote_dim_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        style="@style/Guideline.Fluent2.Start"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        style="@style/Guideline.Fluent2.End"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        style="@style/Guideline.Fluent2.Top"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuideline"
        style="@style/Guideline.Fluent2.Bottom"
        android:orientation="horizontal" />

    <com.axelliant.hris.ui.designsystem.components.AppButtonView
        android:id="@+id/backButton"
        style="@style/Widget.InternalApps.Dashboard.IconButton"
        app:icon="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/topTitleText"
        style="@style/Text.InternalApps.Heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_8"
        android:text="@string/smart_quote_title"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toStartOf="@id/saveText"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/saveText"
        style="@style/Text.InternalApps.Subheading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/smart_quote_save"
        android:textColor="@color/ds_primary"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <LinearLayout
        android:id="@+id/insightLabelRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <ImageView
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_smart_quote_scout_icon"
            android:contentDescription="@null"
            android:padding="@dimen/ds_space_6"
            android:src="@drawable/ic_ai_sparkles"
            app:tint="@color/ds_primary" />

        <com.axelliant.hris.ui.designsystem.components.AppTextView
            style="@style/Text.InternalApps.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.18"
            android:text="@string/smart_quote_ai_insight"
            android:textColor="@color/ds_text_muted" />
    </LinearLayout>

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/insightText"
        style="@style/Text.InternalApps.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_10"
        android:layout_marginTop="@dimen/ds_space_10"
        android:layout_marginEnd="@dimen/ds_space_10"
        android:background="@drawable/bg_smart_quote_insight"
        android:elevation="@dimen/ds_card_elevation"
        android:lineSpacingExtra="@dimen/ds_space_2"
        android:padding="@dimen/ds_space_14"
        android:visibility="gone"
        android:textColor="@color/ds_text_secondary"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/insightLabelRow" />

    <View
        android:id="@+id/screenDimScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/smart_quote_screen_scrim"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cardScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_12"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toTopOf="@id/bottomGuideline"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintStart_toStartOf="@id/startGuideline"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <FrameLayout
            android:id="@+id/cardStackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_8sdp">

            <LinearLayout
                android:id="@+id/nextPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_gravity="center"
                android:alpha="0.96"
                android:background="@drawable/bg_ask_ai_refine_stack_card"
                android:elevation="@dimen/_1sdp"
                android:gravity="top|end"
                android:orientation="vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_7sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_8sdp">

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/nextPreviewStepText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/smart_quote_next_preview"
                    android:textColor="@color/ds_primary" />

                <com.axelliant.hris.ui.designsystem.components.AppTextView
                    android:id="@+id/nextPreviewTitleText"
                    style="@style/Text.InternalApps.Caption"
                    android:layout_width="@dimen/_190sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_text_secondary"
                    tools:text="Which products should we include?" />

                <LinearLayout
                    android:id="@+id/nextPreviewShimmer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_marginEnd="@dimen/_6sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                        <View
                            android:layout_width="@dimen/_92sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/_166sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                    <View
                        android:layout_width="@dimen/_136sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="start"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                        <View
                            android:layout_width="@dimen/_58sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                        <View
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:gravity="start"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/_74sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                        <View
                            android:layout_width="@dimen/_46sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/_148sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                    <View
                        android:layout_width="@dimen/_104sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/_62sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_marginEnd="@dimen/_6sdp"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ask_ai_refine_shimmer_bar" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.axelliant.hris.ui.designsystem.components.AppCardView
                android:id="@+id/activeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/ds_surface"
                app:cardCornerRadius="@dimen/ia_ds_radius_md"
                app:cardElevation="@dimen/_3sdp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@color/smart_quote_shadow_stroke"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_10sdp">

                    <LinearLayout
                        android:id="@+id/progressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ask_ai_refine_header"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/_10sdp">

                            <ImageView
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:background="@drawable/bg_filter_chip"
                                android:contentDescription="@null"
                                android:padding="@dimen/_5sdp"
                                android:src="@drawable/ic_ai_sparkles"
                                app:tint="@color/ds_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.axelliant.hris.ui.designsystem.components.AppTextView
                                    android:id="@+id/stepTitleText"
                                    style="@style/Text.InternalApps.Subheading"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:maxLines="1"
                                    android:textColor="@color/ds_text_primary"
                                    tools:text="Customer" />

                                <com.axelliant.hris.ui.designsystem.components.AppTextView
                                    android:id="@+id/nextStepText"
                                    style="@style/Text.InternalApps.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sdp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/ds_text_secondary"
                                    tools:text="Next: Products" />
                            </LinearLayout>

                            <com.axelliant.hris.ui.designsystem.components.AppTextView
                                android:id="@+id/progressText"
                                style="@style/Text.InternalApps.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_ask_ai_refine_badge"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingStart="@dimen/_7sdp"
                                android:paddingTop="@dimen/_3sdp"
                                android:paddingEnd="@dimen/_7sdp"
                                android:paddingBottom="@dimen/_3sdp"
                                android:textColor="@color/quotes_status_draft_text"
                                tools:text="2 of 7" />
                        </LinearLayout>

                        <com.axelliant.hris.ui.designsystem.components.AppProgressBarView
                            android:id="@+id/stepProgressIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_3sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/ds_primary"
                            app:trackColor="@color/ds_outline" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/questionContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:orientation="vertical">

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/categoryText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="0.16"
                            android:textColor="@color/ds_text_muted"
                            android:visibility="gone" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/questionText"
                            style="@style/Text.InternalApps.Subheading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/ds_text_primary"
                            tools:text="Which customer is this quote for?" />

                        <com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout
                            android:id="@+id/answerInputLayout"
                            style="@style/Widget.InternalApps.InputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            app:boxBackgroundMode="none"
                            app:errorEnabled="true"
                            app:errorIconDrawable="@null"
                            app:hintEnabled="false">

                            <com.axelliant.hris.ui.designsystem.components.AppTextFieldView
                                android:id="@+id/answerInput"
                                style="@style/Widget.InternalApps.InputEditText"
                                android:background="@drawable/bg_smart_quote_input_selector"
                                android:gravity="center_vertical"
                                android:imeOptions="actionDone"
                                android:inputType="textCapSentences"
                                android:minHeight="@dimen/_36sdp"
                                android:paddingStart="@dimen/ds_space_12"
                                android:paddingEnd="@dimen/ds_space_12" />
                        </com.axelliant.hris.ui.designsystem.components.AppTextFieldLayout>

                        <ScrollView
                            android:id="@+id/optionsScroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:fillViewport="false"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/optionsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <com.axelliant.hris.ui.designsystem.components.AppTextView
                            android:id="@+id/helperText"
                            style="@style/Text.InternalApps.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:drawablePadding="@dimen/ds_space_6"
                            android:textColor="@color/ds_text_secondary"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_info_outline"
                            app:drawableTint="@color/ds_primary" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/reviewScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:clipToPadding="false"
                        android:fillViewport="false"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/reviewContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <LinearLayout
                        android:id="@+id/actionRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.axelliant.hris.ui.designsystem.components.AppButtonView
                            android:id="@+id/quoteStepBackButton"
                            style="@style/Widget.InternalApps.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_weight="1"
                            android:text="@string/smart_quote_back"
                            android:textAllCaps="false"
                            android:textSize="@dimen/_9ssp" />

                        <Space
                            android:layout_width="@dimen/_6sdp"
                            android:layout_height="1dp" />

                        <com.axelliant.hris.ui.designsystem.components.AppButtonView
                            android:id="@+id/micButton"
                            android:layout_width="@dimen/_42sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="@drawable/bg_smart_quote_insight"
                            android:contentDescription="@string/smart_quote_listening"
                            android:stateListAnimator="@null"
                            android:text=""
                            android:visibility="gone"
                            app:backgroundTint="@null"
                            app:cornerRadius="@dimen/ia_ds_radius_md"
                            app:icon="@drawable/ia_ic_mic"
                            app:iconGravity="textStart"
                            app:noBackground="true"
                            app:rippleColor="@color/ds_primary_container"
                            app:strokeColor="@color/ds_outline"
                            app:strokeWidth="@dimen/_1sdp" />

                        <com.axelliant.hris.ui.designsystem.components.AppButtonView
                            android:id="@+id/nextButton"
                            style="@style/Widget.InternalApps.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_weight="1.2"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textSize="@dimen/_9ssp"
                            app:cornerRadius="@dimen/ia_ds_radius_md"
                            app:icon="@drawable/ic_chevron_right"
                            app:iconGravity="textEnd" />
                    </LinearLayout>
                </LinearLayout>
            </com.axelliant.hris.ui.designsystem.components.AppCardView>

            <ImageView
                android:id="@+id/swipeBackHint"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="@dimen/_4sdp"
                android:alpha="0.86"
                android:background="@drawable/bg_ask_ai_refine_swipe_hint"
                android:contentDescription="@null"
                android:elevation="@dimen/_4sdp"
                android:padding="@dimen/_5sdp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                android:visibility="gone"
                app:tint="@color/ds_primary"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/swipeNextHint"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/_12sdp"
                android:alpha="0.86"
                android:background="@drawable/bg_ask_ai_refine_swipe_hint"
                android:contentDescription="@null"
                android:elevation="@dimen/_4sdp"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_chevron_right"
                android:visibility="gone"
                app:tint="@color/ds_primary"
                tools:visibility="visible" />
        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>




