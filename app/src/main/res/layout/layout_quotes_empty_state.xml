<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_24"
    android:paddingTop="@dimen/ds_space_32"
    android:paddingEnd="@dimen/ds_space_24"
    android:paddingBottom="@dimen/ds_space_32">

    <ImageView
        android:id="@+id/emptyStateIllustration"
        android:layout_width="@dimen/_96sdp"
        android:layout_height="@dimen/_96sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_quotes_empty" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/emptyStateTitle"
        style="@style/Text.InternalApps.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_16"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:textColor="@color/ds_text_primary" />

    <com.axelliant.hris.ui.designsystem.components.AppTextView
        android:id="@+id/emptyStateDescription"
        style="@style/Text.InternalApps.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        android:gravity="center"
        android:textColor="@color/ds_text_muted" />
</LinearLayout>

