<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ActivityTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorPrimaryDark">@color/ds_primary_pressed</item>
        <item name="colorPrimaryVariant">@color/ds_primary_pressed</item>
        <item name="colorSecondary">@color/ds_secondary</item>
        <item name="colorOnPrimary">@color/ds_on_primary</item>
        <item name="colorOnSecondary">@color/ds_text_primary</item>
        <item name="colorOnBackground">@color/ds_text_primary</item>
        <item name="colorOnSurface">@color/ds_text_primary</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="android:statusBarColor">@color/ds_background</item>
        <item name="android:navigationBarColor">@color/ds_background</item>
        <item name="android:windowBackground">@color/ds_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearanceOverlay.Demo</item>
        <item name="background">@color/ds_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textInputStyle">@style/Widget.Fluent2.InputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Fluent2.Button.Primary</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.AndroidERP" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/ds_text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/ds_text_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
